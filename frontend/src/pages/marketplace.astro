---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { PROFESSIONALS } from "../data/professionals.mjs";
import { CONTEXT_ITEMS } from "../lib/booking-context.mjs";
---

<Layout title="Find a professional | Arc">
  <main class="page-shell text-[var(--ink)]"><Header />
    <section class="mx-auto max-w-[1280px] px-6 pb-20 pt-12 lg:px-10 lg:pb-28 lg:pt-20">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end"><div class="max-w-3xl"><p class="eyebrow">Step 3 of 3 · Choose a next conversation</p><h1 class="section-title mt-5">Professionals who may fit the next question.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">These are fictional demo profiles matched to Alex’s pathway. Arc helps you compare; a licensed professional provides advice.</p></div><a href="/pathway" class="button-secondary shrink-0 focus-ring">← Back to pathway</a></div>
      <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-b border-[var(--line)] pb-4"><div class="flex gap-2" role="group" aria-label="Professional views"><button id="matches-tab" class="tab-button tab-active focus-ring" type="button" aria-pressed="true">Your matches <span>(3)</span></button><button id="browse-tab" class="tab-button focus-ring" type="button" aria-pressed="false">Browse all professionals <span>(6)</span></button></div><p id="result-count" class="text-sm text-[var(--muted)]">3 fictional profiles</p></div>
      <section class="mt-7 rounded-2xl border border-[var(--line)] bg-[var(--pale)] p-5" aria-labelledby="filters-title"><div class="flex flex-wrap items-center justify-between gap-3"><h2 id="filters-title" class="text-sm font-bold">Filter fictional professionals</h2><button id="clear-filters" type="button" class="text-sm font-semibold underline underline-offset-4 focus-ring">Clear filters</button></div><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5"><label class="text-xs font-bold text-[var(--muted)]">Type<select id="type-filter" class="field mt-1"><option value="">All types</option><option>Financial adviser</option><option>Mortgage broker</option><option>Tax accountant</option><option>Conveyancer</option></select></label><label class="text-xs font-bold text-[var(--muted)]">Speciality<input id="speciality-filter" class="field mt-1" type="search" placeholder="e.g. property" /></label><label class="text-xs font-bold text-[var(--muted)]">Brisbane / online<select id="location-filter" class="field mt-1"><option value="">Any location</option><option>Brisbane</option><option>Online</option></select></label><label class="text-xs font-bold text-[var(--muted)]">Price<select id="price-filter" class="field mt-1"><option value="">Any price</option><option value="200">Up to $200</option><option value="250">Up to $250</option><option value="350">Up to $350</option></select></label><label class="text-xs font-bold text-[var(--muted)]">Earliest availability<select id="availability-filter" class="field mt-1"><option value="">Any time</option><option value="2">Within 2 days</option><option value="3">Within 3 days</option><option value="5">Within 5 days</option></select></label></div></section>
      <section id="professional-results" class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3" aria-live="polite">
        {PROFESSIONALS.map((person, index) => <article class={`professional-card ${index > 2 ? "browse-only" : "match-card"} panel flex flex-col p-6`} data-id={person.id} data-type={person.type} data-speciality={`${person.speciality} ${person.specialities.join(" ")}`} data-locations={person.locations.join(",")} data-price={person.price} data-availability={person.availabilityRank}>
          <div class="flex items-start justify-between gap-3"><div class="avatar" style={`background:${person.accent}`}>{person.initials}</div><span class="fictional-badge">Fictional demo profile</span></div><p class="mt-7 text-xs font-bold uppercase tracking-[.12em] text-[var(--quiet)]">{person.type}</p><h2 class="mt-2 font-serif text-3xl">{person.name}</h2><p class="mt-2 min-h-12 text-sm leading-6 text-[var(--muted)]">{person.speciality}</p><div class="mt-6 grid grid-cols-2 gap-3 border-y border-[var(--line)] py-4 text-sm"><div><p class="text-xs text-[var(--quiet)]">Initial consultation</p><p class="mt-1 font-semibold">{person.priceLabel}</p></div><div><p class="text-xs text-[var(--quiet)]">Available</p><p class="mt-1 font-semibold">{person.availability}</p></div></div><p class="mt-5 flex-1 rounded-xl bg-[var(--pale)] p-4 text-sm leading-6 text-[var(--muted)]"><strong class="block text-xs uppercase tracking-[.1em] text-[var(--ink)]">Why Arc matched them</strong><span class="mt-2 block">{person.rationale}</span></p><button type="button" class="button-primary mt-5 w-full focus-ring view-profile" data-person={person.id}>View profile and times <span aria-hidden="true">→</span></button>
        </article>)}
      </section>
      <p id="empty-results" hidden class="panel mt-8 p-10 text-center text-[var(--muted)]">No fictional profiles match those filters. Try clearing one filter.</p>

      <section id="profile-panel" hidden class="mt-12 grid gap-8 lg:grid-cols-[.8fr_1.2fr]" aria-labelledby="profile-title"><div class="panel h-fit bg-[var(--forest)] p-7 text-white"><p class="eyebrow text-[var(--pale)]">Selected fictional profile</p><h2 id="profile-title" tabindex="-1" class="mt-5 font-serif text-4xl"></h2><p id="profile-type" class="mt-2 text-sm text-white/65"></p><p id="profile-speciality" class="mt-7 leading-7 text-white/75"></p><div class="mt-7 border-t border-white/15 pt-5 text-sm"><p class="text-white/50">Initial consultation</p><p id="profile-price" class="mt-1 text-xl"></p><p class="mt-4 text-white/50">Availability</p><p id="profile-availability" class="mt-1"></p></div><p class="mt-7 border-t border-white/15 pt-5 text-xs leading-5 text-white/55">Fictional demo data. Credential verification, payment, calendar, and real booking are out of scope.</p></div>
        <div id="booking-panel" class="panel p-7 lg:p-9"><p class="eyebrow">Context control</p><h2 id="booking-title" class="mt-4 font-serif text-3xl">Choose a time, then choose what to share.</h2><p id="booking-intro" class="mt-3 max-w-xl leading-7 text-[var(--muted)]">Every item starts unchecked. Arc only includes the context you explicitly select in this demo request.</p><p id="preview-only-note" hidden class="mt-6 rounded-xl bg-[var(--pale)] p-4 text-sm leading-6 text-[var(--muted)]">This professional is a later pathway preview. The scripted consultation demo starts with a financial adviser.</p><label id="time-label" class="label mt-7" for="time-select">Select a fictional time</label><select id="time-select" class="field mt-2 max-w-md"><option value="">Choose a time</option></select><fieldset id="context-fieldset" class="mt-7"><legend class="label">Context to share</legend><div class="mt-3 grid gap-3 sm:grid-cols-2">{CONTEXT_ITEMS.map((item) => <label class="flex items-start gap-3 rounded-xl border border-[var(--line)] p-4 text-sm leading-6"><input class="context-check mt-1 h-4 w-4 accent-[#4f8b43]" type="checkbox" value={item.id} /><span>{item.label}</span></label>)}</div></fieldset><p id="sharing-count" class="mt-5 text-sm font-semibold text-[var(--muted)]" aria-live="polite">Sharing 0 items</p><button id="request-consultation" type="button" class="button-primary mt-6 focus-ring" disabled>Request consultation <span aria-hidden="true">→</span></button><p id="booking-disclaimer" class="mt-4 text-xs leading-5 text-[var(--quiet)]">This is a fictional request only. No provider, payment, calendar, or email action occurs.</p><div id="confirmation" hidden class="confirmation-panel mt-8" aria-live="assertive"><p class="eyebrow text-[var(--pale)]">Demo request noted</p><h3 class="mt-3 font-serif text-3xl">Your next conversation is ready.</h3><dl class="mt-6 space-y-3 text-sm"><div><dt class="text-white/55">Professional</dt><dd id="confirm-professional" class="mt-1 font-semibold"></dd></div><div><dt class="text-white/55">Time</dt><dd id="confirm-time" class="mt-1 font-semibold"></dd></div><div><dt class="text-white/55">Shared context</dt><dd id="confirm-context" class="mt-1 leading-6"></dd></div></dl><p class="mt-6 border-t border-white/15 pt-5 text-sm leading-6"><span class="text-white/55">Next pathway step</span><strong id="confirm-next" class="mt-1 block"></strong></p></div></div>
      </section>
    </section>
  </main>
</Layout>

<script>
  import { buildBookingConfirmation, canCreateScriptedConsultation } from "../lib/booking-context.mjs";
  import { PROFESSIONALS } from "../data/professionals.mjs";
  import { loadJourney, saveJourney, updateJourney } from "../lib/journey-state.mjs";
  import { filterProfessionals } from "../lib/marketplace-filter.mjs";
  import { getScrollBehavior } from "../lib/motion-policy.mjs";
  const people = Object.fromEntries(PROFESSIONALS.map((person) => [person.id, { name: person.name, type: person.type, speciality: person.speciality, priceLabel: person.priceLabel, availability: person.availability }]));
  const filterData = PROFESSIONALS.map(({ id, type, speciality, specialities, locations, price, availabilityRank }) => ({ id, type, speciality, specialities, locations, price, availabilityRank }));
  const scrollBehavior = getScrollBehavior(typeof window.matchMedia === "function" && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  const cards = [...document.querySelectorAll(".professional-card")];
  const matchesTab = document.querySelector("#matches-tab"); const browseTab = document.querySelector("#browse-tab");
  const resultCount = document.querySelector("#result-count"); const empty = document.querySelector("#empty-results");
  let mode = "matches";
  const filters = { type: document.querySelector("#type-filter"), speciality: document.querySelector("#speciality-filter"), location: document.querySelector("#location-filter"), price: document.querySelector("#price-filter"), availability: document.querySelector("#availability-filter") };
  const applyFilters = () => {
    const filtered = filterProfessionals(filterData, { type: filters.type.value, speciality: filters.speciality.value, location: filters.location.value, maxPrice: filters.price.value, maxAvailabilityRank: filters.availability.value });
    const allowed = new Set(filtered.map((person) => person.id)); let shown = 0;
    cards.forEach((card) => { const inMode = mode === "matches" ? card.classList.contains("match-card") : true; const visible = inMode && allowed.has(card.dataset.id); card.hidden = !visible; if (visible) shown += 1; });
    resultCount.textContent = `${shown} fictional profile${shown === 1 ? "" : "s"}`; empty.hidden = shown !== 0;
  };
  const setMode = (next) => { mode = next; matchesTab.classList.toggle("tab-active", mode === "matches"); browseTab.classList.toggle("tab-active", mode === "browse"); matchesTab.setAttribute("aria-pressed", String(mode === "matches")); browseTab.setAttribute("aria-pressed", String(mode === "browse")); applyFilters(); };
  matchesTab.addEventListener("click", () => setMode("matches")); browseTab.addEventListener("click", () => setMode("browse"));
  Object.values(filters).forEach((control) => control.addEventListener(control.tagName === "INPUT" ? "input" : "change", applyFilters));
  document.querySelector("#clear-filters").addEventListener("click", () => { Object.values(filters).forEach((control) => { control.value = ""; }); applyFilters(); });
  const profilePanel = document.querySelector("#profile-panel"); const timeSelect = document.querySelector("#time-select"); const request = document.querySelector("#request-consultation"); let selected;
  const timeLabel = document.querySelector("#time-label"); const contextFieldset = document.querySelector("#context-fieldset"); const sharingCount = document.querySelector("#sharing-count"); const previewNote = document.querySelector("#preview-only-note");
  const updateRequestState = () => { const count = document.querySelectorAll(".context-check:checked").length; sharingCount.textContent = `Sharing ${count} item${count === 1 ? "" : "s"}`; request.disabled = !canCreateScriptedConsultation(selected) || !timeSelect.value; };
  const openProfile = (personId, restoredBooking = null) => {
    selected = people[personId]; profilePanel.hidden = false; document.querySelector("#profile-title").textContent = selected.name; document.querySelector("#profile-type").textContent = selected.type; document.querySelector("#profile-speciality").textContent = selected.speciality; document.querySelector("#profile-price").textContent = selected.priceLabel; document.querySelector("#profile-availability").textContent = selected.availability;
    timeSelect.replaceChildren(); const placeholder = document.createElement("option"); placeholder.value = ""; placeholder.textContent = "Choose a time"; timeSelect.append(placeholder); const option = document.createElement("option"); option.value = selected.availability; option.textContent = selected.availability; timeSelect.append(option);
    timeSelect.value = restoredBooking?.time || ""; document.querySelectorAll(".context-check").forEach((check) => { check.checked = restoredBooking && Array.isArray(restoredBooking.sharedItems) ? restoredBooking.sharedItems.includes(check.parentElement.textContent.trim()) : false; }); document.querySelector("#confirmation").hidden = !restoredBooking; request.textContent = "Request consultation →";
    const sharedItems = Array.isArray(restoredBooking?.sharedItems) ? restoredBooking.sharedItems : []; const adviser = canCreateScriptedConsultation(selected); timeLabel.hidden = !adviser; timeSelect.hidden = !adviser; contextFieldset.hidden = !adviser; sharingCount.hidden = !adviser; request.hidden = !adviser; previewNote.hidden = adviser; if (restoredBooking) { document.querySelector("#confirm-professional").textContent = restoredBooking.professional; document.querySelector("#confirm-time").textContent = restoredBooking.time; document.querySelector("#confirm-context").textContent = sharedItems.length ? sharedItems.join(" · ") : "No context selected"; document.querySelector("#confirm-next").textContent = restoredBooking.nextPathwayStep; }
    updateRequestState(); profilePanel.scrollIntoView({ behavior: scrollBehavior, block: "start" }); document.querySelector("#profile-title").focus({ preventScroll: true });
  };
  document.querySelectorAll(".view-profile").forEach((button) => button.addEventListener("click", () => openProfile(button.dataset.person)));
  timeSelect.addEventListener("change", updateRequestState); document.querySelectorAll(".context-check").forEach((check) => check.addEventListener("change", updateRequestState));
  request.addEventListener("click", () => { if (!canCreateScriptedConsultation(selected)) return; const confirmation = buildBookingConfirmation({ professional: selected, time: timeSelect.value, selectedContext: [...document.querySelectorAll(".context-check:checked")].map((check) => check.value), nextPathwayStep: "Mortgage broker" }); document.querySelector("#confirm-professional").textContent = confirmation.professional; document.querySelector("#confirm-time").textContent = confirmation.time; document.querySelector("#confirm-context").textContent = confirmation.sharedItems.length ? confirmation.sharedItems.join(" · ") : "No context selected"; document.querySelector("#confirm-next").textContent = confirmation.nextPathwayStep; document.querySelector("#confirmation").hidden = false; request.textContent = "Consultation request noted"; request.disabled = true; saveJourney(null, updateJourney(loadJourney(), { booking: confirmation, currentStep: "mortgage-broker" })); });
  const journey = loadJourney(); const restoredId = journey.booking && Object.entries(people).find(([, person]) => person.name === journey.booking.professional)?.[0]; if (restoredId && canCreateScriptedConsultation(people[restoredId])) openProfile(restoredId, journey.booking);
  applyFilters();
</script>
