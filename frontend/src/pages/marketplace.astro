---

<Layout title="Your matches | Switchpath">
  <main class="page-shell min-h-screen text-[var(--ink)]">
    <Header />

    <section class="mx-auto max-w-[1280px] px-6 pb-16 pt-6 lg:px-10 lg:pb-24 lg:pt-8">
      <JourneyProgress current="matches" />
      <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--quiet)]">Professional marketplace</p>
          <h1 id="marketplace-title" class="mt-2 font-serif text-4xl leading-none tracking-[-0.035em] sm:text-5xl">Browse professionals</h1>
          <p id="marketplace-intro" class="mt-3 max-w-2xl text-sm leading-6 text-[var(--muted)]">Compare professionals and decide who you would like to speak with first.</p>
        </div>
        <a id="back-to-pathway" href="/pathway" style="display:none" class="button-secondary shrink-0 focus-ring">← Back to your pathway</a>
      </div>

      <div id="view-tabs" style="display:none" class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Professional views">
        <button id="matches-tab" class="view-tab inline-flex items-center gap-2 rounded-full border border-[#262626] bg-[var(--forest)] px-4 py-2.5 text-sm font-medium text-white transition duration-200" type="button" aria-pressed="true">Your matches <span id="matches-count">(3)</span></button>
        <button id="browse-tab" class="view-tab inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--raised)] px-4 py-2.5 text-sm font-medium transition duration-200 hover:border-black/25" type="button" aria-pressed="false">Browse all professionals</button>
      </div>

      <section id="matches-panel" style="display:none" class="mt-6" aria-labelledby="matches-heading">
        <div class="rounded-[24px] border border-[var(--line)] bg-[var(--pale)] p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--quiet)]">Matched to your pathway</p>
          <h2 id="matches-heading" class="mt-2 font-serif text-2xl tracking-[-0.02em]">Your first conversation: <span id="matches-role">Financial adviser</span></h2>
          <p class="mt-2 max-w-3xl text-sm leading-6 text-[var(--muted)]">These profiles reflect what you told Switchpath. Compare them, then choose who you would like to speak with. Advice itself comes from the professional you choose.</p>
        </div>
        <div id="match-results" class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3"></div>
      </section>

      <div id="browse-panel">
        <div class="mt-6 rounded-[24px] border border-[var(--line)] bg-[var(--pale)] p-4 sm:p-5">
          <fieldset>
            <legend class="sr-only">Filter by profession</legend>
            <div class="flex gap-2 overflow-x-auto pb-1" aria-label="Professional types">
              <button class="profession-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-[#262626] bg-[var(--forest)] px-4 py-2.5 text-sm font-medium text-white transition duration-200" type="button" data-profession="all" aria-pressed="true"><span class="filter-check" aria-hidden="true">✓</span>All professionals</button>
              <button class="profession-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--raised)] px-4 py-2.5 text-sm font-medium transition duration-200 hover:border-black/25" type="button" data-profession="accountant" aria-pressed="false"><span class="filter-check hidden" aria-hidden="true">✓</span>Accountants</button>
              <button class="profession-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--raised)] px-4 py-2.5 text-sm font-medium transition duration-200 hover:border-black/25" type="button" data-profession="financial-adviser" aria-pressed="false"><span class="filter-check hidden" aria-hidden="true">✓</span>Financial advisers</button>
              <button class="profession-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--raised)] px-4 py-2.5 text-sm font-medium transition duration-200 hover:border-black/25" type="button" data-profession="lawyer" aria-pressed="false"><span class="filter-check hidden" aria-hidden="true">✓</span>Lawyers</button>
              <button class="profession-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--raised)] px-4 py-2.5 text-sm font-medium transition duration-200 hover:border-black/25" type="button" data-profession="mortgage-broker" aria-pressed="false"><span class="filter-check hidden" aria-hidden="true">✓</span>Mortgage brokers</button>
            </div>
          </fieldset>

          <div class="mt-4 grid gap-3 border-t border-[var(--line)] pt-4 sm:grid-cols-3">
            <label class="text-xs font-semibold text-[var(--muted)]">Meeting format
              <select id="delivery-filter" class="mt-2 w-full rounded-xl border border-[var(--line)] bg-[var(--raised)] px-3 py-3 text-sm font-normal text-[var(--ink)] transition duration-200 hover:border-black/25">
                <option value="all">Any format</option>
                <option value="face-to-face">Face-to-face</option>
                <option value="online">Online</option>
              </select>
            </label>
            <label class="text-xs font-semibold text-[var(--muted)]">Consultation price
              <select id="price-filter" class="mt-2 w-full rounded-xl border border-[var(--line)] bg-[var(--raised)] px-3 py-3 text-sm font-normal text-[var(--ink)] transition duration-200 hover:border-black/25">
                <option value="999">Any price</option>
                <option value="0">No initial fee</option>
                <option value="150">Up to $150</option>
                <option value="200">Up to $200</option>
                <option value="250">Up to $250</option>
                <option value="300">Up to $300</option>
              </select>
            </label>
            <label class="text-xs font-semibold text-[var(--muted)]">Earliest availability
              <select id="availability-filter" class="mt-2 w-full rounded-xl border border-[var(--line)] bg-[var(--raised)] px-3 py-3 text-sm font-normal text-[var(--ink)] transition duration-200 hover:border-black/25">
                <option value="99">Any time</option>
                <option value="0">Today</option>
                <option value="3">Within 3 days</option>
                <option value="7">Within 7 days</option>
              </select>
            </label>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between gap-4">
          <p class="text-sm text-[var(--muted)]" aria-live="polite"><span id="result-count" class="font-semibold text-[var(--ink)]">8</span> professionals available</p>
          <button id="clear-filters" class="rounded-full px-3 py-2 text-sm font-medium text-[var(--muted)] underline decoration-black/25 underline-offset-4 transition duration-200 hover:text-[var(--ink)]" type="button">Clear filters</button>
        </div>

        <div id="professional-results" class="mt-3 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {professionals.map((professional) => (
            <article class="professional-card flex min-h-[480px] flex-col rounded-[24px] border border-[var(--line)] bg-[var(--raised)] p-6 shadow-[0_14px_36px_rgba(23,23,23,0.035)] transition duration-200 hover:-translate-y-0.5 hover:border-[var(--line)] hover:shadow-[0_18px_44px_rgba(23,23,23,0.07)]" data-profession={professional.professionKey} data-delivery={professional.deliveryKeys.join(",")} data-price={professional.price} data-availability={professional.availabilityDays}>
              <div class="flex items-start gap-4">
                <img src={professional.headshot} alt="" class="h-14 w-14 shrink-0 rounded-full border border-[var(--line)] bg-[var(--pale)] object-cover" loading="lazy" decoding="async" />
                <div class="min-w-0 pt-0.5">
                  <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--quiet)]">{professional.profession}</p>
                  <h2 class="mt-1 text-xl font-semibold tracking-[-0.025em]">{professional.name}</h2>
                  <p class="mt-1 text-sm text-[var(--muted)]">{professional.qualification}</p>
                  <p class="mt-1 text-xs text-[var(--quiet)]">{professional.location}</p>
                </div>
              </div>

              <h3 class="mt-5 text-lg font-medium leading-6">{professional.speciality}</h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {professional.specialties.map((item) => <span class="rounded-full border border-[var(--line)] bg-[var(--canvas)] px-3 py-1.5 text-xs text-[var(--muted)]">{item}</span>)}
              </div>

              <div class="mt-5 rounded-2xl bg-[var(--pale)] p-4">
                <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--quiet)]">Why this may suit you</p>
                <p class="mt-2 text-sm leading-6 text-[var(--muted)]">{professional.rationale}</p>
              </div>

              <div class="mt-auto pt-5">
                <div class="grid grid-cols-2 gap-3 border-t border-[var(--line)] pt-4">
                  <div>
                    <p class="text-[11px] text-[var(--quiet)]">Consultation</p>
                    <p class="mt-1 text-sm font-semibold">{professional.priceLabel} · {professional.duration}</p>
                  </div>
                  <div>
                    <p class="text-[11px] text-[var(--quiet)]">Earliest time</p>
                    <p class="mt-1 text-sm font-semibold">{professional.nextTime}</p>
                  </div>
                </div>
                <button class="open-profile mt-4 flex w-full items-center justify-between rounded-full bg-[var(--lime)] px-5 py-3.5 text-sm font-semibold text-[var(--ink)] transition duration-200 hover:bg-[#d5f49e]" type="button" data-id={professional.id}>View full profile <span aria-hidden="true">→</span></button>
              </div>
            </article>
          ))}
        </div>

        <div id="empty-results" class="mt-4 hidden rounded-[24px] border border-dashed border-[var(--line)] bg-[var(--raised)] p-10 text-center" aria-live="polite">
          <h2 class="font-serif text-2xl">No professionals match every filter.</h2>
          <p class="mt-2 text-sm text-[var(--muted)]">Clear a filter to see more profiles.</p>
        </div>
      </div>
    </section>

    <section class="border-t border-[var(--line)] bg-[var(--pale)]">
      <div class="mx-auto flex max-w-[1400px] flex-col gap-3 px-5 py-7 sm:flex-row sm:items-center sm:justify-between sm:px-7 lg:px-10">
        <h2 class="font-serif text-2xl tracking-[-0.02em]">Compare first. Decide when you are ready.</h2>
        <p class="max-w-2xl text-sm leading-6 text-[var(--muted)]">Switchpath helps you compare professional services. Financial, credit, tax and legal advice is provided only by the qualified professional you choose.</p>
      </div>
    </section>

    <footer class="border-t border-[var(--line)] bg-[var(--canvas)]"><div class="mx-auto flex max-w-[1280px] flex-col justify-between gap-5 px-6 py-10 text-sm text-[var(--muted)] sm:flex-row lg:px-10"><div><img src="/brand/switchpath-lockup.png" alt="Switchpath" width="2172" height="724" class="block h-10 w-auto -my-2.5" /><p class="mt-2 max-w-lg text-xs leading-5">Switchpath guides you to questions and professional roles. It does not provide financial, credit, tax, legal, or investment advice.</p></div><p>© 2026 Switchpath</p></div></footer>
  </main>

  <dialog id="profile-dialog" class="m-auto w-[min(820px,calc(100vw-24px))] max-h-[calc(100vh-24px)] overflow-auto rounded-[28px] border-0 bg-[var(--canvas)] p-0 text-[var(--ink)] shadow-[0_30px_90px_rgba(23,23,23,0.35)] backdrop:bg-[#12231b]/65" aria-labelledby="dialog-title">
    <button id="dialog-close" class="absolute right-5 top-5 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-[var(--line)] bg-[var(--raised)] text-xl transition duration-200 hover:border-black/25" type="button" aria-label="Close profile">×</button>
    <div id="dialog-content"></div>
  </dialog>

  <script type="application/json" id="directory-data" set:html={JSON.stringify(professionals)}></script>

  <script>
    import { loadJourney } from "../lib/journey-state.mjs";
    import { normalizeGeneratedJourney } from "../lib/ai-contract.mjs";

    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
    const directory = JSON.parse(document.querySelector('#directory-data').textContent);
    const professionButtons = document.querySelectorAll('.profession-filter');
    const professionalCards = document.querySelectorAll('.professional-card');
    const deliveryFilter = document.querySelector('#delivery-filter');
    const priceFilter = document.querySelector('#price-filter');
    const availabilityFilter = document.querySelector('#availability-filter');
    const resultCount = document.querySelector('#result-count');
    const emptyResults = document.querySelector('#empty-results');
    const dialog = document.querySelector('#profile-dialog');
    const dialogContent = document.querySelector('#dialog-content');
    let activeProfession = 'all';
    let dialogOpener;

    const applyFilters = () => {
      let visible = 0;
      professionalCards.forEach((card) => {
        const deliveryOptions = card.dataset.delivery.split(',');
        const professionMatch = activeProfession === 'all' || card.dataset.profession === activeProfession;
        const deliveryMatch = deliveryFilter.value === 'all' || deliveryOptions.includes(deliveryFilter.value);
        const priceMatch = Number(card.dataset.price) <= Number(priceFilter.value);
        const availabilityMatch = Number(card.dataset.availability) <= Number(availabilityFilter.value);
        const show = professionMatch && deliveryMatch && priceMatch && availabilityMatch;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });
      resultCount.textContent = String(visible);
      emptyResults.classList.toggle('hidden', visible !== 0);
    };

    professionButtons.forEach((button) => button.addEventListener('click', () => {
      activeProfession = button.dataset.profession;
      professionButtons.forEach((item) => {
        const active = item === button;
        item.setAttribute('aria-pressed', String(active));
        item.classList.toggle('border-[#262626]', active);
        item.classList.toggle('bg-[var(--forest)]', active);
        item.classList.toggle('text-white', active);
        item.classList.toggle('border-[var(--line)]', !active);
        item.classList.toggle('bg-[var(--raised)]', !active);
        item.querySelector('.filter-check').classList.toggle('hidden', !active);
      });
      applyFilters();
    }));

    [deliveryFilter, priceFilter, availabilityFilter].forEach((select) => select.addEventListener('change', applyFilters));
    document.querySelector('#clear-filters').addEventListener('click', () => {
      deliveryFilter.value = 'all';
      priceFilter.value = '999';
      availabilityFilter.value = '99';
      professionButtons[0].click();
    });

    const profiles = new Map(directory.map((professional) => [professional.id, professional]));

    const avatar = (professional, size) => professional.headshot
      ? `<img src="${escapeHtml(professional.headshot)}" alt="" class="${size} shrink-0 rounded-full border border-[var(--line)] bg-[var(--pale)] object-cover" loading="lazy" decoding="async"/>`
      : `<span class="${size} flex shrink-0 items-center justify-center rounded-full border border-[var(--line)] bg-[var(--lime)] text-sm font-semibold" aria-hidden="true">${escapeHtml(professional.initials || '')}</span>`;

    const openProfile = (id, opener) => {
      const professional = profiles.get(id);
      if (!professional) return;
      dialogOpener = opener;
      dialogContent.innerHTML = `
        <div class="border-b border-[var(--line)] bg-[var(--raised)] p-7 pr-16 sm:p-9 sm:pr-20">
          <div class="flex gap-4 sm:gap-5">
            ${avatar(professional, 'h-20 w-20')}
            <div class="pt-0.5">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--quiet)]">${escapeHtml(professional.profession)}</p>
              <h2 id="dialog-title" class="mt-1 font-serif text-3xl leading-none tracking-[-0.035em] sm:text-4xl">${escapeHtml(professional.name)}</h2>
              <p class="mt-3 text-[var(--muted)]">${escapeHtml(professional.qualification)}</p>
              <p class="mt-1 text-sm text-[var(--quiet)]">${escapeHtml(professional.location)}</p>
            </div>
          </div>
        </div>
        <div class="space-y-7 p-7 sm:p-9">
          <div class="rounded-2xl bg-[var(--pale)] p-5">
            <p class="text-[10px] font-semibold uppercase tracking-[0.15em] text-[var(--quiet)]">Why this professional may suit you</p>
            <p class="mt-3 leading-7 text-[var(--muted)]">${escapeHtml(professional.rationale)}</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[var(--quiet)]">How they work</p>
            <h3 class="mt-3 text-xl font-semibold">${escapeHtml(professional.speciality)}</h3>
            ${professional.approach ? `<p class="mt-3 leading-7 text-[var(--muted)]">${escapeHtml(professional.approach)}</p>` : ''}
            <div class="mt-4 flex flex-wrap gap-2">${professional.specialties.map((item) => `<span class="rounded-full border border-[var(--line)] bg-[var(--raised)] px-3 py-1.5 text-xs text-[var(--muted)]">${escapeHtml(item)}</span>`).join('')}</div>
          </div>
          <div class="grid gap-px overflow-hidden rounded-2xl bg-black/10 sm:grid-cols-3">
            <div class="bg-[var(--raised)] p-4"><p class="text-xs text-[var(--quiet)]">Consultation</p><p class="mt-1 font-semibold">${escapeHtml(professional.priceLabel)} · ${escapeHtml(professional.duration)}</p></div>
            <div class="bg-[var(--raised)] p-4"><p class="text-xs text-[var(--quiet)]">Format</p><p class="mt-1 font-semibold">${escapeHtml(professional.location)}</p></div>
            <div class="bg-[var(--raised)] p-4"><p class="text-xs text-[var(--quiet)]">Next available</p><p class="mt-1 font-semibold">${escapeHtml(professional.nextTime)}</p></div>
          </div>
          <form id="booking-form" novalidate>
            <fieldset>
              <legend class="text-sm font-semibold">Choose a consultation time</legend>
              <div class="mt-3 grid gap-2 sm:grid-cols-3">${professional.times.map((time) => `<label class="flex cursor-pointer items-start gap-2 rounded-xl border border-[var(--line)] bg-[var(--raised)] p-3 text-sm transition duration-200 hover:border-black/25"><input type="radio" name="time" value="${escapeHtml(time)}" class="mt-0.5 accent-[#262626]"/><span>${escapeHtml(time)}</span></label>`).join('')}</div>
              <p id="time-error" class="mt-2 hidden text-xs text-[#8b3f35]">Choose a time before continuing.</p>
            </fieldset>
            <button class="mt-6 flex w-full items-center justify-between rounded-full bg-[var(--lime)] px-6 py-4 text-sm font-semibold text-[var(--ink)] transition duration-200 hover:bg-[#d5f49e]" type="submit">Request consultation <span aria-hidden="true">→</span></button>
            <p class="mt-3 text-center text-xs text-[var(--quiet)]">No payment is taken when requesting an introduction.</p>
          </form>
          <div id="booking-confirmation" class="hidden rounded-[22px] bg-[var(--forest)] p-6 text-white sm:p-7">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Request ready</p>
            <h3 class="mt-3 font-serif text-3xl tracking-[-0.025em]">Meet ${escapeHtml(professional.name)}.</h3>
            <p id="confirmation-copy" class="mt-3 text-sm leading-6 text-white/65"></p>
          </div>
        </div>`;
      dialog.showModal();
      dialogContent.querySelector('#booking-form').addEventListener('submit', (event) => {
        event.preventDefault();
        const time = dialogContent.querySelector('input[name="time"]:checked');
        const error = dialogContent.querySelector('#time-error');
        if (!time) { error.classList.remove('hidden'); return; }
        error.classList.add('hidden');
        dialogContent.querySelector('#confirmation-copy').textContent = `${time.value} selected. Switchpath will use this preference when preparing the introduction.`;
        dialogContent.querySelector('#booking-form').classList.add('hidden');
        dialogContent.querySelector('#booking-confirmation').classList.remove('hidden');
        localStorage.setItem('switchpath.consultation.v1', JSON.stringify({ professional: professional.id, time: time.value }));
      });
    };

    const bindProfileButtons = (root) => root.querySelectorAll('.open-profile').forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => openProfile(button.dataset.id, button));
    });

    bindProfileButtons(document);
    document.querySelector('#dialog-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => dialogOpener?.focus());

    const journeyMatches = () => {
      const journey = loadJourney();
      if (!Array.isArray(journey.generatedMatches) || journey.generatedMatches.length === 0) return null;
      try {
        const normalized = normalizeGeneratedJourney({ summary: journey.generatedSummary, recommendedRole: journey.recommendedRole, pathway: journey.generatedPathway, matches: journey.generatedMatches });
        return { role: normalized.recommendedRole, matches: normalized.matches };
      } catch { return null; }
    };

    const toProfile = (person) => ({
      id: `match-${person.id}`,
      headshot: person.photo,
      initials: person.initials,
      name: person.name,
      profession: person.type,
      qualification: `${person.consultationMinutes}-minute initial consultation`,
      speciality: person.speciality,
      specialties: person.specialities,
      location: person.locationLabel,
      priceLabel: person.priceAud === 0 ? 'No initial fee' : `$${person.priceAud}`,
      duration: `${person.consultationMinutes} min`,
      nextTime: person.availability,
      times: [person.availability],
      rationale: person.rationale,
      approach: '',
    });

    const matchCard = (professional) => `
      <article class="flex min-h-[440px] flex-col rounded-[24px] border border-[var(--line)] bg-[var(--raised)] p-6 shadow-[0_14px_36px_rgba(23,23,23,0.035)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_44px_rgba(23,23,23,0.07)]">
        <div class="flex items-start gap-4">
          ${avatar(professional, 'h-14 w-14')}
          <div class="min-w-0 pt-0.5">
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--quiet)]">${escapeHtml(professional.profession)}</p>
            <h3 class="mt-1 text-xl font-semibold tracking-[-0.025em]">${escapeHtml(professional.name)}</h3>
            <p class="mt-1 text-sm text-[var(--muted)]">${escapeHtml(professional.qualification)}</p>
            <p class="mt-1 text-xs text-[var(--quiet)]">${escapeHtml(professional.location)}</p>
          </div>
        </div>
        <h4 class="mt-5 text-lg font-medium leading-6">${escapeHtml(professional.speciality)}</h4>
        <div class="mt-3 flex flex-wrap gap-2">${professional.specialties.map((item) => `<span class="rounded-full border border-[var(--line)] bg-[var(--canvas)] px-3 py-1.5 text-xs text-[var(--muted)]">${escapeHtml(item)}</span>`).join('')}</div>
        <div class="mt-5 rounded-2xl bg-[var(--pale)] p-4">
          <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[var(--quiet)]">Why Switchpath matched them</p>
          <p class="mt-2 text-sm leading-6 text-[var(--muted)]">${escapeHtml(professional.rationale)}</p>
        </div>
        <div class="mt-auto pt-5">
          <div class="grid grid-cols-2 gap-3 border-t border-[var(--line)] pt-4">
            <div><p class="text-[11px] text-[var(--quiet)]">Consultation</p><p class="mt-1 text-sm font-semibold">${escapeHtml(professional.priceLabel)} · ${escapeHtml(professional.duration)}</p></div>
            <div><p class="text-[11px] text-[var(--quiet)]">Earliest time</p><p class="mt-1 text-sm font-semibold">${escapeHtml(professional.nextTime)}</p></div>
          </div>
          <button class="open-profile mt-4 flex w-full items-center justify-between rounded-full bg-[var(--lime)] px-5 py-3.5 text-sm font-semibold text-[var(--ink)] transition duration-200 hover:bg-[#d5f49e]" type="button" data-id="${escapeHtml(professional.id)}">View full profile <span aria-hidden="true">→</span></button>
        </div>
      </article>`;

    const tabs = document.querySelector('#view-tabs');
    const matchesTab = document.querySelector('#matches-tab');
    const browseTab = document.querySelector('#browse-tab');
    const matchesPanel = document.querySelector('#matches-panel');
    const browsePanel = document.querySelector('#browse-panel');

    const show = (element, visible) => { element.style.display = visible ? '' : 'none'; };

    const setTab = (tab) => {
      const showMatches = tab === matchesTab;
      show(matchesPanel, showMatches);
      show(browsePanel, !showMatches);
      [matchesTab, browseTab].forEach((item) => {
        const active = item === tab;
        item.setAttribute('aria-pressed', String(active));
        item.classList.toggle('border-[#262626]', active);
        item.classList.toggle('bg-[var(--forest)]', active);
        item.classList.toggle('text-white', active);
        item.classList.toggle('border-[var(--line)]', !active);
        item.classList.toggle('bg-[var(--raised)]', !active);
      });
    };

    const generated = journeyMatches();
    if (generated) {
      const matchProfiles = generated.matches.map(toProfile);
      matchProfiles.forEach((professional) => profiles.set(professional.id, professional));
      const matchResults = document.querySelector('#match-results');
      matchResults.innerHTML = matchProfiles.map(matchCard).join('');
      bindProfileButtons(matchResults);
      document.querySelector('#matches-role').textContent = generated.role;
      document.querySelector('#matches-count').textContent = `(${matchProfiles.length})`;
      document.querySelector('#marketplace-title').textContent = 'Your matches';
      document.querySelector('#marketplace-intro').textContent = 'Switchpath matched these professionals to the first step of your pathway. Browse everyone else whenever you want a wider view.';
      show(document.querySelector('#back-to-pathway'), true);
      show(tabs, true);
      matchesTab.addEventListener('click', () => setTab(matchesTab));
      browseTab.addEventListener('click', () => setTab(browseTab));
      setTab(matchesTab);
    }

    applyFilters();
  </script>
</Layout>

<style>
  :global(button:focus-visible),
  :global(a:focus-visible),
  :global(select:focus-visible),
  :global(input:focus-visible) {
    outline: 3px solid #6a851b;
    outline-offset: 3px;
  }

  #profile-dialog[open] {
    animation: modal-in 180ms ease-out;
  }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(10px) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
</style>
