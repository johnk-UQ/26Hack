---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import JourneyProgress from "../components/JourneyProgress.astro";
import { INTAKE_RESPONSES } from "../data/demo-content.mjs";
const mode = import.meta.env.PUBLIC_JOURNEY_MODE === "demo" ? "demo" : "ai";
---
<Layout title="Tell Switchpath what’s happening | Switchpath">
<main class="page-shell text-[var(--ink)]" data-journey-mode={mode}><Header /><section class="mx-auto max-w-[1280px] px-6 pb-12 pt-6 lg:px-10 lg:pb-16 lg:pt-8"><JourneyProgress current="profile" /><div class="mt-7"><h1 class="onboarding-title">Tell us what is happening.</h1></div>
<div class="onboarding-layout mx-auto mt-5 max-w-[1080px]"><section class="conversation-shell" aria-labelledby="conversation-title"><h2 id="conversation-title" class="sr-only">Switchpath assistant</h2><p id="progress" class="sr-only" role="status" aria-live="polite">Your profile</p>
<div id="conversation" class="conversation-viewport px-0" role="log" aria-label="Switchpath intake conversation" aria-live="polite"><article class="conversation-step"><div class="conversation-turn conversation-turn-alex mt-0"><div class="min-w-0 flex-1"><label class="sr-only" for="situation">Your situation</label><textarea id="situation" class="field response-composer min-h-20 resize-none text-sm leading-6" rows="2" placeholder="Tell us what’s happening in your life.">{mode === "demo" ? INTAKE_RESPONSES[0] : ""}</textarea></div></div><div class="response-controls mt-3 flex justify-end"><button id="send-situation" type="button" class="send-control focus-ring" aria-label="Send response" title="Send response"><span aria-hidden="true">→</span></button></div></article>
<article id="analysis" hidden class="analysis-panel mt-5" aria-live="polite"><p class="eyebrow">Building your pathway</p><ol><li>Understanding your situation</li><li>Ordering the conversations</li><li>Preparing your first matches</li></ol><p id="error" hidden class="mt-4 text-sm text-red-700"></p><button id="see-pathway" hidden type="button" class="button-primary mt-5 focus-ring">See my pathway <span aria-hidden="true">→</span></button></article></div></section>
</div></section></main></Layout>
<script>
import { DEMO_CONVERSATION } from "../data/demo-content.mjs";
import { loadJourney, saveJourney, updateJourney } from "../lib/journey-state.mjs";
import { createAiJourneyClient, createExampleJourney, publicError } from "../lib/ai-journey-client.mjs";
const root = document.querySelector("[data-journey-mode]"); const mode = root?.dataset.journeyMode === "demo" ? "demo" : "ai";
const situation = document.querySelector("#situation"); const conversation = document.querySelector("#conversation"); const send = document.querySelector("#send-situation"); const analysis = document.querySelector("#analysis"); const seePathway = document.querySelector("#see-pathway"); const error = document.querySelector("#error"); let busy = false; let pendingAnswers = []; let followUp = { question: null, answer: null }; const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches; const wait = (ms) => new Promise((resolve) => setTimeout(resolve, reduced ? 0 : ms)); const scrollChat = () => conversation?.scrollTo({ top: conversation.scrollHeight, behavior: reduced ? "auto" : "smooth" });
const reveal = async ({ role, text }) => { const node = document.createElement("article"); node.className = role === "assistant" ? "conversation-turn conversation-turn-assistant mt-4" : "conversation-turn conversation-turn-alex mt-4"; if (role === "assistant") node.innerHTML = '<div class="avatar avatar-lime avatar-small" aria-hidden="true"><img src="/brand/switchpath-mark.png" alt="" class="h-6 w-6 object-contain" /></div><div class="bubble bubble-arc"><p class="text-[.68rem] font-bold uppercase tracking-[.14em] text-[var(--quiet)]">Switchpath</p><p class="message-text is-streaming mt-1 whitespace-pre-line text-sm leading-6"></p></div>'; else node.innerHTML = '<div class="bubble bubble-alex ml-auto whitespace-pre-line text-sm leading-6"><p class="message-text is-streaming"></p></div>'; conversation.append(node); const target = node.querySelector(".message-text"); for (const token of text.split(/(\s+)/)) { target.textContent += token; scrollChat(); await wait(34); } target.classList.remove("is-streaming"); await wait(420); };
const finish = async () => { analysis.hidden = false; scrollChat(); for (const item of analysis.querySelectorAll("li")) { await wait(320); item.classList.add("is-complete"); scrollChat(); } seePathway.hidden = false; scrollChat(); };
const showError = (cause) => { analysis.hidden = false; error.textContent = publicError(cause).message; error.hidden = false; send.hidden = false; situation.readOnly = false; busy = false; scrollChat(); };
const saveAndGo = (result, source) => { const next = updateJourney(loadJourney(), { initialSituation: pendingAnswers[0], intakeResponses: pendingAnswers, followUpQuestion: followUp.question, followUpAnswer: followUp.answer, generatedSummary: result.summary, generatedPathway: result.pathway, generatedMatches: result.matches, recommendedRole: result.recommendedRole, generationSource: source, currentStep: "adviser" }); saveJourney(null, next); location.assign("/pathway"); };
const runDemo = async () => { pendingAnswers = [situation.value.trim()]; for (const message of DEMO_CONVERSATION) { await reveal(message); if (message.role === "user" && pendingAnswers.length < 2) pendingAnswers.push(message.text); } await finish(); };
const runAi = async () => { const client = createAiJourneyClient(); pendingAnswers = [situation.value.trim()]; if (!pendingAnswers[0]) { showError({ code: "INVALID_REQUEST" }); return; } const clarified = await client.clarify(pendingAnswers[0]); if (clarified.status === "needs_clarification") { followUp.question = clarified.question; await reveal({ role: "assistant", text: clarified.question }); const node = document.createElement("article"); node.className = "conversation-step mt-4"; node.innerHTML = '<textarea id="follow-up-answer" class="field response-composer min-h-20 resize-none text-sm leading-6" rows="2" placeholder="Add any context that would help."></textarea><div class="response-controls mt-3 flex justify-end"><button id="send-follow-up" type="button" class="send-control focus-ring" aria-label="Send follow-up response"><span aria-hidden="true">→</span></button></div>'; conversation.append(node); scrollChat(); const followUpAnswer = node.querySelector("#follow-up-answer"); const followUpSend = node.querySelector("#send-follow-up"); await new Promise((resolve) => followUpSend.addEventListener("click", async () => { followUp.answer = followUpAnswer.value.trim(); if (!followUp.answer) return; followUpAnswer.readOnly = true; followUpSend.hidden = true; pendingAnswers.push(followUp.answer); resolve(); })); } const result = await client.generate({ situation: pendingAnswers[0], ...(followUp.question ? { followUpQuestion: followUp.question, followUpAnswer: followUp.answer } : {}) }); await finish(); seePathway.onclick = () => saveAndGo(result, "groq"); };
send.addEventListener("click", async () => { if (busy) return; busy = true; send.hidden = true; situation.readOnly = true; try { if (mode === "demo") { await runDemo(); seePathway.onclick = () => saveAndGo(createExampleJourney(), "example"); } else await runAi(); } catch (cause) { showError(cause); } });
</script>
