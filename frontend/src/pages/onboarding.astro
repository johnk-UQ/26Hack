---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { INTAKE_RESPONSES } from "../data/demo-content.mjs";
---
<Layout title="Tell Switchpath what’s happening | Switchpath">
<main class="page-shell text-[var(--ink)]"><Header /><section class="mx-auto max-w-[1280px] px-6 pb-16 pt-12 lg:px-10 lg:pb-24 lg:pt-20"><div class="max-w-3xl"><p class="eyebrow">Step 1 of 3 · Your situation</p><h1 class="section-title mt-5">Tell us what is happening.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">There is no right terminology. We’ll explain which professional conversations may come first.</p></div>
<div class="onboarding-layout mt-12 grid gap-8 lg:grid-cols-[1.2fr_.8fr]"><section class="conversation-shell" aria-labelledby="conversation-title"><div class="flex items-center justify-between border-b border-[var(--line)] px-0 py-5"><div class="flex items-center gap-3"><div class="avatar avatar-lime" aria-hidden="true"><img src="/brand/switchpath-mark.png" alt="" class="h-6 w-6 object-contain" /></div><div><h2 id="conversation-title" class="font-semibold">Switchpath assistant</h2><p class="text-xs text-[var(--quiet)]"></p></div></div><p id="progress" class="text-sm font-semibold text-[var(--muted)]" role="status" aria-live="polite">Your situation</p></div>
<div id="conversation" class="conversation-viewport px-0 py-8" role="log" aria-label="Switchpath intake conversation" aria-live="polite"><article class="conversation-step"><div class="conversation-turn conversation-turn-assistant"><div class="avatar avatar-lime avatar-small" aria-hidden="true"><img src="/brand/switchpath-mark.png" alt="" class="h-6 w-6 object-contain" /></div><div class="bubble bubble-arc max-w-none"><p class="text-xs font-bold uppercase tracking-[.14em] text-[var(--quiet)]">Switchpath asks</p><p class="mt-2 text-base leading-7">What’s happening in your financial life?</p></div></div><div class="conversation-turn conversation-turn-alex"><div class="min-w-0 flex-1"><label class="sr-only" for="situation">Your situation</label><textarea id="situation" class="field response-composer mt-2 min-h-28 resize-none leading-6" rows="4">{INTAKE_RESPONSES[0]}</textarea></div></div><p id="answer-error" class="mt-2 text-sm font-semibold text-[#a43b2b]" role="alert" hidden>Please add a little more detail before continuing.</p><div class="response-controls mt-5 flex justify-end"><button id="send-situation" type="button" class="send-control focus-ring" aria-label="Send response" title="Send response"><span aria-hidden="true">→</span></button></div></article></div>
<article id="analysis" hidden class="analysis-panel" aria-live="polite"><p class="eyebrow">A considered starting point</p><ol><li>Understanding your situation</li><li>Ordering the conversations</li><li>Preparing your first step</li></ol></article><p id="failure" hidden class="mt-5 rounded-xl bg-[var(--pale)] p-5 text-sm leading-6" role="alert"></p><div id="failure-actions" hidden class="mt-4 flex flex-wrap gap-3"><button id="try-again" type="button" class="button-primary focus-ring">Try again</button><button id="continue-example" type="button" class="button-secondary focus-ring">Continue with the example journey</button></div></section>
<aside class="panel panel-dark h-fit p-6 text-white lg:sticky lg:top-6 lg:p-8"><p class="eyebrow eyebrow-on-dark">What happens next</p><h2 class="mt-4 font-serif text-3xl leading-tight">Switchpath will show who may help, and in what order.</h2><ol class="mt-8 space-y-5"><li>01 · <strong>Listen</strong></li><li>02 · <strong>Explain</strong></li><li>03 · <strong>Connect</strong></li></ol><p class="mt-9 border-t border-white/15 pt-5 text-xs leading-5 text-white/70">Switchpath does not provide regulated advice.</p></aside></div></section></main></Layout>
<script>
import { loadJourney, saveJourney, updateJourney } from "../lib/journey-state.mjs";
import { createAiJourneyClient, createExampleJourney, isPropertyLike } from "../lib/ai-journey-client.mjs";
const state = loadJourney(); const situation = document.querySelector("#situation"); const autosize = (field) => { field.style.height = "auto"; field.style.height = `${field.scrollHeight}px`; }; autosize(situation); situation.addEventListener("input", () => autosize(situation)); const conversation = document.querySelector("#conversation"); const send = document.querySelector("#send-situation"); const error = document.querySelector("#answer-error"); const analysis = document.querySelector("#analysis"); const failure = document.querySelector("#failure"); const actions = document.querySelector("#failure-actions"); let busy = false; let followUp = null; let lastAnswers = []; const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches; const wait = (ms) => new Promise((resolve) => setTimeout(resolve, reduced ? 0 : ms)); const scrollChat = () => conversation?.scrollTo({ top: conversation.scrollHeight, behavior: reduced ? "auto" : "smooth" });
const reveal = async (text) => { const node = document.createElement("article"); node.className = "conversation-turn conversation-turn-assistant mt-6"; node.innerHTML = '<div class="avatar avatar-lime avatar-small" aria-hidden="true"><img src="/brand/switchpath-mark.png" alt="" class="h-6 w-6 object-contain" /></div><div class="bubble bubble-arc"><p class="text-xs font-bold uppercase tracking-[.14em] text-[var(--quiet)]">Switchpath asks</p><p class="follow-up-text mt-2 text-base leading-7"></p></div>'; conversation.append(node); const target = node.querySelector(".follow-up-text"); for (const word of text.split(/(\s+)/)) { target.textContent += word; scrollChat(); await wait(18); } return node; };
const saveAndGo = (result, source, answers) => { const next = updateJourney(loadJourney(), { initialSituation: answers[0], intakeResponses: answers, followUpQuestion: followUp?.question || null, followUpAnswer: followUp?.answer || null, generatedSummary: result.summary, generatedPathway: result.pathway, generatedMatches: result.matches, recommendedRole: result.recommendedRole, generationSource: source, currentStep: "adviser" }); saveJourney(null, next); location.assign("/pathway"); };
const generate = async (answers, sourceOnFailure = true) => { lastAnswers = [...answers]; analysis.hidden = false; analysis.querySelectorAll("li").forEach((item) => item.classList.remove("is-complete")); scrollChat(); const request = createAiJourneyClient().generate({ situation: answers[0], ...(followUp ? { followUpQuestion: followUp.question, followUpAnswer: followUp.answer } : {}) }); const animation = (async () => { for (const item of analysis.querySelectorAll("li")) { await wait(260); item.classList.add("is-complete"); scrollChat(); } })(); try { const [result] = await Promise.all([request, animation]); saveAndGo(result, "groq", answers); } catch (cause) { if (sourceOnFailure && isPropertyLike(answers)) { saveAndGo(createExampleJourney(), "example", answers); return; } failure.hidden = false; failure.textContent = "We couldn’t build that pathway just yet. You can try again, or continue with Switchpath’s example journey."; actions.hidden = false; busy = false; send.disabled = false; } };
send.addEventListener("click", async () => { if (busy) return; const answer = situation.value.trim(); if (answer.length < 10) { error.hidden = false; situation.focus(); return; } error.hidden = true; busy = true; send.disabled = true; const answers = [answer]; const client = createAiJourneyClient(); try { const clarification = await client.clarify(answer); if (clarification.status === "needs_clarification") { followUp = { question: clarification.question }; const node = await reveal(clarification.question); const field = document.createElement("textarea"); field.className = "field response-composer mt-3 min-h-24 resize-none leading-6"; field.rows = 3; field.placeholder = "Your answer"; field.setAttribute("aria-label", "Answer to follow-up question"); autosize(field); field.addEventListener("input", () => autosize(field)); node.querySelector(".bubble").append(field); const button = document.createElement("button"); button.type = "button"; button.className = "send-control focus-ring mt-3"; button.setAttribute("aria-label", "Send follow-up response"); button.textContent = "→"; node.append(button); button.addEventListener("click", async () => { if (!field.value.trim() || followUp.answer) return; followUp.answer = field.value.trim(); button.disabled = true; await generate([answer, followUp.answer]); }); busy = false; send.hidden = true; field.focus(); } else await generate(answers); } catch { await generate(answers); } });
document.querySelector("#try-again").addEventListener("click", async () => { if (busy || !lastAnswers.length) return; failure.hidden = true; actions.hidden = true; busy = true; send.disabled = true; await generate(lastAnswers); }); document.querySelector("#continue-example").addEventListener("click", () => saveAndGo(createExampleJourney(), "example", lastAnswers.length ? lastAnswers : [situation.value.trim()])); document.querySelector("#restart-demo")?.addEventListener("click", () => { try { localStorage.removeItem("switchpath.demoJourney.v2"); } catch {} });
</script>
