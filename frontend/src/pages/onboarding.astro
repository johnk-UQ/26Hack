---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { INTAKE_PROMPTS, INTAKE_RESPONSES } from "../data/demo-content.mjs";
---

<Layout title="Tell Arc what’s happening | Arc">
  <main class="page-shell text-[var(--ink)]">
    <Header />
    <section class="mx-auto max-w-[1280px] px-6 pb-16 pt-12 lg:px-10 lg:pb-24 lg:pt-20">
      <div class="max-w-3xl"><p class="eyebrow">Step 1 of 3 · Your situation</p><h1 class="section-title mt-5">Tell us what is happening.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">There is no right terminology. We’ll use your answers to explain which professional questions may come first.</p></div>
      <div class="mt-12 grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
        <section class="panel overflow-hidden" aria-labelledby="conversation-title">
          <div class="flex items-center justify-between border-b border-[var(--line)] px-6 py-5 sm:px-8"><div class="flex items-center gap-3"><div class="avatar avatar-lime" aria-hidden="true">A</div><div><h2 id="conversation-title" class="font-semibold">Arc assistant</h2><p class="text-xs text-[var(--quiet)]">A scripted demo for Alex · fictional context</p></div></div><p id="progress" class="text-sm font-semibold text-[var(--muted)]">1 / 5</p></div>
          <div id="conversation" class="px-6 py-8 sm:px-8">
            {INTAKE_PROMPTS.map((prompt, index) => <article class="conversation-step" data-step={index} hidden={index !== 0}>
              <div class="bubble bubble-arc max-w-none"><p class="text-xs font-bold uppercase tracking-[.14em] text-[var(--quiet)]">Arc asks</p><p class="mt-2 text-base leading-7">{prompt}</p></div>
              <label class="label mt-7" for={`answer-${index}`}>Alex’s response <span class="normal-case font-normal tracking-normal text-[var(--quiet)]">(editable)</span></label>
              <textarea id={`answer-${index}`} class="field mt-2 min-h-28 resize-y leading-6" rows="3">{INTAKE_RESPONSES[index]}</textarea>
              <div class="mt-5 flex flex-wrap justify-between gap-3"><button type="button" class="button-secondary back-button focus-ring" data-back disabled={index === 0}>← Back</button><button type="button" class="button-primary next-button focus-ring" data-next>{index === INTAKE_PROMPTS.length - 1 ? "Review my situation" : "Use this response"} <span aria-hidden="true">→</span></button></div>
            </article>)}
            <article id="review" hidden class="rounded-2xl bg-[var(--pale)] p-5"><p class="eyebrow">Captured context</p><h2 class="mt-3 font-serif text-3xl">Here’s what Arc heard.</h2><p class="mt-3 leading-7 text-[var(--muted)]">Review the five answers before Arc lays out a pathway. This is navigation, not financial advice.</p><dl id="review-list" class="mt-6 space-y-4"></dl><div class="mt-7 flex flex-wrap justify-between gap-3"><button id="edit-answers" type="button" class="button-secondary focus-ring">← Edit answers</button><a href="/pathway" id="build-pathway" class="button-primary focus-ring">Build my pathway <span aria-hidden="true">↗</span></a></div></article>
          </div>
        </section>
        <aside class="panel h-fit bg-[var(--forest)] p-6 text-white lg:sticky lg:top-6 lg:p-8"><p class="eyebrow text-[var(--pale)]">What happens next</p><h2 class="mt-4 font-serif text-3xl leading-tight">Arc will show who may help, and in what order.</h2><ol class="mt-8 space-y-5"><li class="flex gap-3"><span class="text-white/45">01</span><span><strong class="block">Listen</strong><small class="mt-1 block text-white/60">Capture the moment in your words.</small></span></li><li class="flex gap-3"><span class="text-white/45">02</span><span><strong class="block">Explain</strong><small class="mt-1 block text-white/60">Name roles, reasons, timing, and questions.</small></span></li><li class="flex gap-3"><span class="text-white/45">03</span><span><strong class="block">Connect</strong><small class="mt-1 block text-white/60">Compare fictional demo profiles when you’re ready.</small></span></li></ol><p class="mt-9 border-t border-white/15 pt-5 text-xs leading-5 text-white/55">Arc does not recommend investments, properties, loans, tax structures, or providers as objectively best.</p></aside>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { loadJourney, saveJourney, updateJourney } from "../lib/journey-state.mjs";
  const state = loadJourney();
  const steps = [...document.querySelectorAll(".conversation-step")];
  const review = document.querySelector("#review");
  const progress = document.querySelector("#progress");
  const answers = steps.map((step) => step.querySelector("textarea"));
  let active = 0;
  const show = (index) => {
    active = Math.max(0, Math.min(index, steps.length));
    steps.forEach((step, i) => { step.hidden = i !== active; });
    review.hidden = active !== steps.length;
    progress.textContent = active === steps.length ? "Ready" : `${active + 1} / ${steps.length}`;
    if (active === steps.length) {
      const list = document.querySelector("#review-list");
      list.innerHTML = answers.map((answer, i) => `<div class="border-b border-[var(--line)] pb-3"><dt class="text-xs font-bold uppercase tracking-[.12em] text-[var(--quiet)]">${i + 1}. ${steps[i].querySelector(".bubble p:last-child").textContent}</dt><dd class="mt-1 leading-6">${answer.value}</dd></div>`).join("");
    }
  };
  steps.forEach((step, index) => {
    step.querySelector("[data-next]")?.addEventListener("click", () => { if (index === steps.length - 1) show(steps.length); else show(index + 1); });
    step.querySelector("[data-back]")?.addEventListener("click", () => show(index - 1));
  });
  document.querySelector("#edit-answers")?.addEventListener("click", () => show(steps.length - 1));
  document.querySelector("#build-pathway")?.addEventListener("click", () => {
    const next = updateJourney(state, { intakeResponses: answers.map((answer) => answer.value), currentStep: "adviser" });
    saveJourney(null, next);
  });
</script>
