---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { INTAKE_PROMPTS, INTAKE_RESPONSES } from "../data/demo-content.mjs";
---
<Layout title="Tell Switchpath what’s happening | Switchpath">
<main class="page-shell text-[var(--ink)]"><Header /><section class="mx-auto max-w-[1280px] px-6 pb-16 pt-12 lg:px-10 lg:pb-24 lg:pt-20"><div class="max-w-3xl"><p class="eyebrow">Step 1 of 3 · Your situation</p><h1 class="section-title mt-5">Tell us what is happening.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">There is no right terminology. We’ll use your answers to explain which professional questions may come first.</p></div>
<div id="onboarding-layout" class="onboarding-layout mt-12 grid gap-8 lg:grid-cols-[1.2fr_.8fr]"><section class="conversation-shell" aria-labelledby="conversation-title"><div id="conversation-header" class="flex items-center justify-between border-b border-[var(--line)] px-0 py-5"><div class="flex items-center gap-3"><div class="avatar avatar-lime" aria-hidden="true">S</div><div><h2 id="conversation-title" class="font-semibold">Switchpath assistant</h2><p class="text-xs text-[var(--quiet)]">Your words stay editable</p></div></div><p id="progress" class="text-sm font-semibold text-[var(--muted)]" role="status" aria-live="polite">Step 1 of 5</p></div>
<div id="conversation" class="conversation-viewport px-0 py-8" role="log" aria-label="Switchpath intake conversation" aria-live="polite">{INTAKE_PROMPTS.map((prompt, index) => <article class="conversation-step" data-step={index} hidden={index !== 0}><div class="conversation-turn conversation-turn-assistant"><div class="avatar avatar-lime avatar-small" aria-hidden="true">S</div><div class="bubble bubble-arc max-w-none"><p class="text-xs font-bold uppercase tracking-[.14em] text-[var(--quiet)]">Switchpath asks</p><p id={`prompt-${index}`} class="mt-2 text-base leading-7">{prompt}</p></div></div><div class="conversation-turn conversation-turn-alex"><div class="min-w-0 flex-1"><label class="sr-only" for={`answer-${index}`}>Response for Switchpath prompt {index + 1}</label><textarea id={`answer-${index}`} aria-label={`Response for Switchpath prompt ${index + 1}`} class="field response-composer mt-2 min-h-28 resize-y leading-6" rows="3" required>{INTAKE_RESPONSES[index]}</textarea></div></div><p id={`answer-error-${index}`} class="mt-2 text-sm font-semibold text-[#a43b2b]" role="alert" hidden>Please add a response before continuing.</p><div class="response-controls mt-5 flex flex-wrap items-center justify-between gap-3" data-controls><button type="button" class="button-secondary focus-ring" data-back disabled={index === 0}>← Back</button><button type="button" class="send-control focus-ring" data-next aria-label="Send response" title="Send response"><span aria-hidden="true">→</span></button></div></article>)}</div><article id="analysis" hidden class="analysis-panel" aria-live="polite"><p class="eyebrow">A considered starting point</p><ol><li>Understanding your situation</li><li>Ordering the conversations</li><li>Preparing your first step</li></ol></article></section>
<aside class="panel panel-dark h-fit p-6 text-white lg:sticky lg:top-6 lg:p-8"><p class="eyebrow eyebrow-on-dark">What happens next</p><h2 class="mt-4 font-serif text-3xl leading-tight">Switchpath will show who may help, and in what order.</h2><ol class="mt-8 space-y-5"><li>01 · <strong>Listen</strong></li><li>02 · <strong>Explain</strong></li><li>03 · <strong>Connect</strong></li></ol><p class="mt-9 border-t border-white/15 pt-5 text-xs leading-5 text-white/70">Switchpath does not provide regulated advice.</p></aside></div></section></main></Layout>
<script>
import { loadJourney, saveJourney, updateJourney } from "../lib/journey-state.mjs";
const state=loadJourney(), steps=[...document.querySelectorAll('.conversation-step')], answers=steps.map(s=>s.querySelector('textarea')), analysis=document.querySelector('#analysis'), conversation=document.querySelector('#conversation'), progress=document.querySelector('#progress'); let active=0,busy=false; state.intakeResponses.forEach((r,i)=>answers[i]&&(answers[i].value=r)); const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches; const wait=ms=>new Promise(r=>setTimeout(r,reduced?0:ms)); const scrollChat=()=>conversation?.scrollTo({top:conversation.scrollHeight,behavior:reduced?'auto':'smooth'}); const show=i=>{active=i;steps.forEach((s,n)=>{s.hidden=n>i;const controls=s.querySelector('[data-controls]');if(controls)controls.hidden=n!==i});progress.textContent=i===steps.length?'Preparing your recommendation':`Step ${i+1} of ${steps.length}`;scrollChat()}; const streamPrompt=async(index)=>{const prompt=steps[index]?.querySelector(`#prompt-${index}`);if(!prompt||reduced)return;const full=prompt.textContent;prompt.textContent='';for(const word of full.split(/(\s+)/)){prompt.textContent+=word;scrollChat();await wait(18)}};
steps.forEach((step,index)=>{const answer=answers[index],error=step.querySelector('[role=alert]'),controls=step.querySelector('[data-controls]'),send=step.querySelector('[data-next]'); answer.addEventListener('input',()=>{if(answer.value.trim())error.hidden=true}); send.addEventListener('click',async()=>{if(busy)return;if(!answer.value.trim()){error.hidden=false;answer.focus();return}busy=true;send.disabled=true;await wait(280);controls.hidden=true;if(index<steps.length-1){show(index+1);await streamPrompt(index+1);answers[index+1].focus();scrollChat();busy=false}else{show(steps.length);analysis.hidden=false;scrollChat();for(const li of analysis.querySelectorAll('li')){await wait(260);li.classList.add('is-complete');scrollChat()}await wait(260);saveJourney(null,updateJourney(state,{intakeResponses:answers.map(a=>a.value),currentStep:'adviser'}));location.assign('/pathway')}});step.querySelector('[data-back]').addEventListener('click',()=>{if(index>0)show(index-1)});});
</script>
