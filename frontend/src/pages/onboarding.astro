---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Build your investor profile | Arc">

  <main class="min-h-screen bg-[#f4f1ea] text-[#171717]">

    <!-- TOP BAR -->
    <header class="border-b border-black/10 bg-[#f4f1ea]">
      <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-5 lg:px-10">

        <a href="/" class="text-2xl font-semibold tracking-[-0.04em]">
          arc
        </a>

        <p class="text-sm text-black/50">
          Investor profile
        </p>

      </div>
    </header>


    <!-- PAGE INTRO -->
    <section class="mx-auto max-w-[1200px] px-6 pt-16 lg:px-10 lg:pt-20">

      <div class="max-w-3xl">

        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black/50">
          Build your profile
        </p>

        <h1 class="mt-5 text-5xl font-medium leading-[1.05] tracking-[-0.045em] sm:text-6xl">
          Tell us what you're looking for.
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-black/60">
          Share your goals, risk preferences and investment horizon.
          We'll turn them into a simple investor profile and show relevant
          private-market opportunities.
        </p>

      </div>

    </section>


    <!-- MODE TABS -->
    <section class="mx-auto max-w-[1200px] px-6 pt-10 lg:px-10">

      <div class="inline-flex rounded-full border border-black/15 bg-white p-1">

        <button
          class="rounded-full bg-black px-5 py-2.5 text-sm font-medium text-white"
        >
          Chat with Arc
        </button>

        <button
          class="rounded-full px-5 py-2.5 text-sm font-medium text-black/60"
        >
          Use sliders
        </button>

      </div>

    </section>


    <!-- CHAT INTERFACE -->
    <section class="mx-auto max-w-[1200px] px-6 py-12 lg:px-10">

      <div class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">

        <!-- CHAT PANEL -->
        <div class="overflow-hidden border border-black/10 bg-white">

          <!-- Chat header -->
          <div class="flex items-center gap-3 border-b border-black/10 px-6 py-5">

            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-[#d8ff75] text-sm font-semibold">
              A
            </div>

            <div>
              <p class="font-medium">
                Arc assistant
              </p>

              <p class="text-xs text-black/40">
                Investor profile builder
              </p>
            </div>

          </div>


          <!-- Chat content -->
          <div class="space-y-8 px-6 py-8 sm:px-8">

            <!-- AI message -->
            <div class="flex gap-3">

              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#d8ff75] text-xs font-semibold">
                A
              </div>

              <div class="max-w-[78%] rounded-2xl rounded-tl-sm bg-[#f2efe8] px-5 py-4">

                <p class="leading-7">
                  Hi — I'll help build a simple investor profile.
                  To start, what are you hoping to achieve with this investment?
                </p>

              </div>

            </div>


            <!-- User message -->
            <div class="flex justify-end">

              <div class="max-w-[78%] rounded-2xl rounded-tr-sm bg-black px-5 py-4 text-white">

                <p class="leading-7">
                  I'm looking for strong long-term growth and I'm happy to
                  invest for 10 years or more.
                </p>

              </div>

            </div>


            <!-- AI message -->
            <div class="flex gap-3">

              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#d8ff75] text-xs font-semibold">
                A
              </div>

              <div class="max-w-[78%] rounded-2xl rounded-tl-sm bg-[#f2efe8] px-5 py-4">

                <p class="leading-7">
                  Great. How comfortable are you with higher-risk investments
                  that may be difficult to sell for several years?
                </p>

              </div>

            </div>


            <!-- Quick response chips -->
            <div class="flex flex-wrap gap-2 pl-11">

              <button class="rounded-full border border-black/15 px-4 py-2 text-sm hover:bg-black hover:text-white">
                Very comfortable
              </button>

              <button class="rounded-full border border-black/15 px-4 py-2 text-sm hover:bg-black hover:text-white">
                Somewhat comfortable
              </button>

              <button class="rounded-full border border-black/15 px-4 py-2 text-sm hover:bg-black hover:text-white">
                Not comfortable
              </button>

            </div>

          </div>


          <!-- Input box -->
          <div class="border-t border-black/10 p-5">

            <div class="flex items-center gap-3 rounded-xl border border-black/15 bg-[#fafafa] px-4 py-3">

              <input
                type="text"
                placeholder="Type your answer..."
                class="min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-black/30"
              />

              <button
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-black text-white"
              >
                →
              </button>

            </div>

          </div>

        </div>


        <!-- PROFILE PREVIEW -->
        <aside class="border border-black/10 bg-[#171717] p-7 text-white">

          <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/40">
            Profile preview
          </p>

          <h2 class="mt-5 text-3xl font-medium tracking-[-0.03em]">
            Growth Investor
          </h2>

          <p class="mt-3 text-sm leading-6 text-white/50">
            Your profile updates as you answer more questions.
          </p>


          <div class="mt-10 space-y-7">

            <!-- Risk -->
            <div>

              <div class="mb-3 flex justify-between text-sm">
                <span class="text-white/50">
                  Risk tolerance
                </span>

                <span>
                  High
                </span>
              </div>

              <div class="h-1 rounded-full bg-white/15">
                <div class="h-1 w-[82%] rounded-full bg-[#d8ff75]"></div>
              </div>

            </div>


            <!-- Growth -->
            <div>

              <div class="mb-3 flex justify-between text-sm">
                <span class="text-white/50">
                  Growth preference
                </span>

                <span>
                  High
                </span>
              </div>

              <div class="h-1 rounded-full bg-white/15">
                <div class="h-1 w-[90%] rounded-full bg-[#d8ff75]"></div>
              </div>

            </div>


            <!-- Time -->
            <div class="border-t border-white/10 pt-5">

              <p class="text-xs uppercase tracking-wider text-white/40">
                Time horizon
              </p>

              <p class="mt-2 text-xl">
                10+ years
              </p>

            </div>


            <!-- Liquidity -->
            <div class="border-t border-white/10 pt-5">

              <p class="text-xs uppercase tracking-wider text-white/40">
                Liquidity need
              </p>

              <p class="mt-2 text-xl">
                Low
              </p>

            </div>


            <!-- Interests -->
            <div class="border-t border-white/10 pt-5">

              <p class="text-xs uppercase tracking-wider text-white/40">
                Interests
              </p>

              <div class="mt-3 flex flex-wrap gap-2">

                <span class="rounded-full border border-white/20 px-3 py-1 text-xs">
                  Infrastructure
                </span>

                <span class="rounded-full border border-white/20 px-3 py-1 text-xs">
                  AI
                </span>

                <span class="rounded-full border border-white/20 px-3 py-1 text-xs">
                  Renewable energy
                </span>

              </div>

            </div>

          </div>


          <a
            href="/marketplace"
            class="mt-10 block rounded-full bg-[#d8ff75] px-5 py-3.5 text-center text-sm font-medium text-black"
          >
            Generate my matches →
          </a>

        </aside>

      </div>

    </section>


    <!-- MANUAL INPUT OPTION -->
    <section class="border-t border-black/10 bg-[#ebe7df]">

      <div class="mx-auto max-w-[1200px] px-6 py-20 lg:px-10">

        <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">

          <div>

            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black/50">
              Prefer manual controls?
            </p>

            <h2 class="mt-4 text-4xl font-medium tracking-[-0.04em]">
              Set your profile directly.
            </h2>

            <p class="mt-5 max-w-md leading-7 text-black/55">
              Adjust a few key preferences instead of using the chat.
            </p>

          </div>


          <div class="space-y-10">

            <!-- Risk slider -->
            <div>

              <div class="mb-4 flex justify-between">
                <label class="font-medium">
                  Risk tolerance
                </label>

                <span class="text-sm text-black/50">
                  High
                </span>
              </div>

              <input
                type="range"
                min="1"
                max="5"
                value="4"
                class="w-full accent-black"
              />

              <div class="mt-2 flex justify-between text-xs text-black/40">
                <span>Low</span>
                <span>High</span>
              </div>

            </div>


            <!-- Horizon slider -->
            <div>

              <div class="mb-4 flex justify-between">
                <label class="font-medium">
                  Investment horizon
                </label>

                <span class="text-sm text-black/50">
                  10+ years
                </span>
              </div>

              <input
                type="range"
                min="1"
                max="5"
                value="5"
                class="w-full accent-black"
              />

              <div class="mt-2 flex justify-between text-xs text-black/40">
                <span>1 year</span>
                <span>10+ years</span>
              </div>

            </div>


            <!-- Liquidity slider -->
            <div>

              <div class="mb-4 flex justify-between">
                <label class="font-medium">
                  Liquidity requirement
                </label>

                <span class="text-sm text-black/50">
                  Low
                </span>
              </div>

              <input
                type="range"
                min="1"
                max="5"
                value="2"
                class="w-full accent-black"
              />

              <div class="mt-2 flex justify-between text-xs text-black/40">
                <span>Low</span>
                <span>High</span>
              </div>

            </div>


            <!-- Investment amount -->
            <div>

              <label class="block font-medium">
                Amount available to invest
              </label>

              <div class="mt-3 flex items-center border border-black/15 bg-white px-4 py-3">

                <span class="mr-2 text-black/40">
                  $
                </span>

                <input
                  type="number"
                  value="2000"
                  class="w-full bg-transparent outline-none"
                />

              </div>

            </div>


            <!-- Themes -->
            <div>

              <label class="block font-medium">
                Areas of interest
              </label>

              <div class="mt-4 flex flex-wrap gap-2">

                <button class="rounded-full bg-black px-4 py-2 text-sm text-white">
                  Infrastructure
                </button>

                <button class="rounded-full border border-black/15 px-4 py-2 text-sm">
                  Private equity
                </button>

                <button class="rounded-full border border-black/15 px-4 py-2 text-sm">
                  Private credit
                </button>

                <button class="rounded-full bg-black px-4 py-2 text-sm text-white">
                  AI
                </button>

                <button class="rounded-full bg-black px-4 py-2 text-sm text-white">
                  Renewable energy
                </button>

                <button class="rounded-full border border-black/15 px-4 py-2 text-sm">
                  Real estate
                </button>

              </div>

            </div>


            <a
              href="/marketplace"
              class="inline-block rounded-full bg-black px-7 py-3.5 text-sm font-medium text-white"
            >
              Find matching opportunities →
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>

</Layout>