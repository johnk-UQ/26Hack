---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sarah Chen | Arc">

  <main class="min-h-screen bg-[#f7f5f0] text-[#17201e]">

    <!-- NAV -->
    <header class="border-b border-black/10 bg-[#f7f5f0]">
      <nav class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-5 lg:px-10">

        <a href="/" class="text-2xl font-semibold tracking-[-0.04em]">
          arc
        </a>

        <a
          href="/matches"
          class="text-sm text-black/55 transition hover:text-black"
        >
          ← Back to accountants
        </a>

      </nav>
    </header>


    <!-- MAIN PROFILE -->
    <section class="mx-auto max-w-[1400px] px-6 py-12 lg:px-10 lg:py-16">

      <div class="grid gap-10 lg:grid-cols-[1fr_380px]">

        <!-- LEFT CONTENT -->
        <div class="min-w-0">

          <!-- PROFILE HEADER -->
          <div class="rounded-[28px] border border-black/10 bg-white p-7 sm:p-9">

            <div class="flex flex-col gap-6 sm:flex-row sm:items-start">

              <!-- Avatar -->
              <div class="flex h-28 w-28 shrink-0 items-center justify-center rounded-full bg-[#d9ffc5] text-3xl font-medium">
                SC
              </div>


              <div class="flex-1">

                <div class="flex flex-wrap items-center gap-3">

                  <h1 class="text-4xl font-medium tracking-[-0.04em]">
                    Sarah Chen
                  </h1>

                  <span class="rounded-full bg-[#e9f6e2] px-3 py-1.5 text-xs font-medium">
                    VERIFIED
                  </span>

                </div>

                <p class="mt-2 text-lg text-black/50">
                  CPA · Registered Tax Agent
                </p>


                <!-- Rating -->
                <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">

                  <span class="tracking-wider">
                    ★★★★★
                  </span>

                  <span class="font-medium">
                    4.9
                  </span>

                  <span class="text-black/40">
                    128 reviews
                  </span>

                  <span class="text-black/20">
                    ·
                  </span>

                  <span class="text-black/50">
                    400+ clients helped
                  </span>

                </div>


                <!-- Quick facts -->
                <div class="mt-6 flex flex-wrap gap-2">

                  <span class="rounded-full bg-[#f5f3ee] px-4 py-2 text-sm">
                    Online consultations
                  </span>

                  <span class="rounded-full bg-[#f5f3ee] px-4 py-2 text-sm">
                    Brisbane
                  </span>

                  <span class="rounded-full bg-[#f5f3ee] px-4 py-2 text-sm">
                    English
                  </span>

                  <span class="rounded-full bg-[#f5f3ee] px-4 py-2 text-sm">
                    Mandarin
                  </span>

                </div>

              </div>

            </div>

          </div>


          <!-- ABOUT -->
          <section class="mt-6 rounded-[28px] border border-black/10 bg-white p-7 sm:p-9">

            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-black/35">
              About
            </p>

            <h2 class="mt-4 text-2xl font-medium tracking-[-0.02em]">
              Accounting without the unnecessary complexity.
            </h2>

            <p class="mt-5 max-w-3xl leading-8 text-black/60">
              Sarah specialises in helping young professionals, investors and
              freelancers navigate tax and accounting in a clear, practical way.
              She regularly works with clients who have PAYG income alongside
              shares, ETFs, side businesses and other investments.
            </p>

            <p class="mt-4 max-w-3xl leading-8 text-black/60">
              Her approach focuses on helping clients understand what information
              they need, what may be relevant to their situation, and what happens
              next — without assuming they already understand accounting terminology.
            </p>

          </section>


          <!-- SPECIALISATIONS -->
          <section class="mt-6 rounded-[28px] border border-black/10 bg-white p-7 sm:p-9">

            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-black/35">
              Areas of expertise
            </p>

            <h2 class="mt-4 text-2xl font-medium">
              Sarah regularly helps with
            </h2>


            <div class="mt-7 grid gap-3 sm:grid-cols-2">

              <div class="rounded-2xl bg-[#f7f5f0] p-5">
                <p class="font-medium">
                  Individual tax returns
                </p>

                <p class="mt-2 text-sm leading-6 text-black/50">
                  PAYG income, deductions and annual tax returns.
                </p>
              </div>


              <div class="rounded-2xl bg-[#f7f5f0] p-5">
                <p class="font-medium">
                  Shares & ETFs
                </p>

                <p class="mt-2 text-sm leading-6 text-black/50">
                  Dividends, distributions and capital gains.
                </p>
              </div>


              <div class="rounded-2xl bg-[#f7f5f0] p-5">
                <p class="font-medium">
                  Freelance & side income
                </p>

                <p class="mt-2 text-sm leading-6 text-black/50">
                  Freelancing, consulting income, ABNs and deductions.
                </p>
              </div>


              <div class="rounded-2xl bg-[#f7f5f0] p-5">
                <p class="font-medium">
                  Cryptocurrency
                </p>

                <p class="mt-2 text-sm leading-6 text-black/50">
                  Transaction records and capital gains considerations.
                </p>
              </div>


              <div class="rounded-2xl bg-[#f7f5f0] p-5">
                <p class="font-medium">
                  Young professionals
                </p>

                <p class="mt-2 text-sm leading-6 text-black/50">
                  First jobs, working from home and understanding tax obligations.
                </p>
              </div>


              <div class="rounded-2xl bg-[#f7f5f0] p-5">
                <p class="font-medium">
                  Tax planning
                </p>

                <p class="mt-2 text-sm leading-6 text-black/50">
                  General tax planning and preparation for upcoming obligations.
                </p>
              </div>

            </div>

          </section>


          <!-- LANGUAGES / DETAILS -->
          <section class="mt-6 rounded-[28px] border border-black/10 bg-white p-7 sm:p-9">

            <div class="grid gap-8 sm:grid-cols-3">

              <div>
                <p class="text-xs uppercase tracking-[0.15em] text-black/35">
                  Languages
                </p>

                <p class="mt-3 font-medium">
                  English
                </p>

                <p class="mt-1 font-medium">
                  Mandarin
                </p>
              </div>


              <div>
                <p class="text-xs uppercase tracking-[0.15em] text-black/35">
                  Consultation
                </p>

                <p class="mt-3 font-medium">
                  Online video
                </p>

                <p class="mt-1 text-sm text-black/45">
                  Australia-wide
                </p>
              </div>


              <div>
                <p class="text-xs uppercase tracking-[0.15em] text-black/35">
                  Experience
                </p>

                <p class="mt-3 font-medium">
                  8 years
                </p>

                <p class="mt-1 text-sm text-black/45">
                  Individual & investor tax
                </p>
              </div>

            </div>

          </section>


          <!-- SERVICES -->
          <section class="mt-6 rounded-[28px] border border-black/10 bg-white p-7 sm:p-9">

            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-black/35">
              Services & pricing
            </p>

            <h2 class="mt-4 text-2xl font-medium">
              Choose the help you need.
            </h2>


            <div class="mt-7 divide-y divide-black/10 border-y border-black/10">

              <!-- SERVICE -->
              <div class="flex flex-col justify-between gap-4 py-6 sm:flex-row sm:items-center">

                <div>
                  <p class="font-medium">
                    Tax consultation
                  </p>

                  <p class="mt-1 text-sm text-black/45">
                    30-minute online consultation
                  </p>
                </div>

                <p class="text-xl font-medium">
                  $79
                </p>

              </div>


              <!-- SERVICE -->
              <div class="flex flex-col justify-between gap-4 py-6 sm:flex-row sm:items-center">

                <div>
                  <p class="font-medium">
                    Individual tax return
                  </p>

                  <p class="mt-1 text-sm text-black/45">
                    PAYG individual tax return
                  </p>
                </div>

                <p class="text-xl font-medium">
                  From $179
                </p>

              </div>


              <!-- SERVICE -->
              <div class="flex flex-col justify-between gap-4 py-6 sm:flex-row sm:items-center">

                <div>
                  <p class="font-medium">
                    Investment tax review
                  </p>

                  <p class="mt-1 text-sm text-black/45">
                    Shares, ETFs and capital gains review
                  </p>
                </div>

                <p class="text-xl font-medium">
                  $120
                </p>

              </div>

            </div>

          </section>


          <!-- REVIEWS -->
          <section class="mt-6 rounded-[28px] border border-black/10 bg-white p-7 sm:p-9">

            <div class="flex items-end justify-between">

              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-black/35">
                  Client reviews
                </p>

                <h2 class="mt-4 text-2xl font-medium">
                  What clients say
                </h2>
              </div>

              <div class="text-right">
                <p class="text-3xl font-medium">
                  4.9
                </p>

                <p class="mt-1 text-sm">
                  ★★★★★
                </p>
              </div>

            </div>


            <div class="mt-8 grid gap-4 sm:grid-cols-2">

              <article class="rounded-2xl bg-[#f7f5f0] p-5">

                <p class="text-sm">
                  ★★★★★
                </p>

                <p class="mt-4 leading-7 text-black/65">
                  “Sarah explained everything clearly and helped me understand
                  what documents I actually needed for my first tax return.”
                </p>

                <p class="mt-5 text-sm font-medium">
                  Emily R.
                </p>

                <p class="text-xs text-black/35">
                  Young professional
                </p>

              </article>


              <article class="rounded-2xl bg-[#f7f5f0] p-5">

                <p class="text-sm">
                  ★★★★★
                </p>

                <p class="mt-4 leading-7 text-black/65">
                  “Really helpful with my ETF investments and freelance income.
                  Everything was explained without accounting jargon.”
                </p>

                <p class="mt-5 text-sm font-medium">
                  Marcus T.
                </p>

                <p class="text-xs text-black/35">
                  Freelancer
                </p>

              </article>

            </div>

          </section>

        </div>


        <!-- RIGHT BOOKING PANEL -->
        <aside>

          <div class="sticky top-6 rounded-[28px] border border-black/10 bg-white p-7">

            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-black/35">
              Book with Sarah
            </p>

            <h2 class="mt-4 text-2xl font-medium tracking-[-0.02em]">
              Tax consultation
            </h2>


            <div class="mt-5 space-y-3 text-sm">

              <div class="flex justify-between">
                <span class="text-black/45">
                  Format
                </span>

                <span class="font-medium">
                  Online video
                </span>
              </div>

              <div class="flex justify-between">
                <span class="text-black/45">
                  Duration
                </span>

                <span class="font-medium">
                  30 minutes
                </span>
              </div>

              <div class="flex justify-between">
                <span class="text-black/45">
                  Price
                </span>

                <span class="font-medium">
                  $79
                </span>
              </div>

            </div>


            <div class="my-6 border-t border-black/10"></div>


            <p class="text-sm font-medium">
              Next available
            </p>


            <div class="mt-4 space-y-2">

              <button class="w-full rounded-xl border border-black/15 px-4 py-3 text-left text-sm transition hover:border-black">
                <span class="font-medium">
                  Today
                </span>

                <span class="float-right">
                  5:30 PM
                </span>
              </button>


              <button class="w-full rounded-xl border border-black/15 px-4 py-3 text-left text-sm transition hover:border-black">
                <span class="font-medium">
                  Tomorrow
                </span>

                <span class="float-right">
                  10:00 AM
                </span>
              </button>


              <button class="w-full rounded-xl border border-black/15 px-4 py-3 text-left text-sm transition hover:border-black">
                <span class="font-medium">
                  Tomorrow
                </span>

                <span class="float-right">
                  4:30 PM
                </span>
              </button>

            </div>


            <a
              href="/booking/sarah-chen"
              class="mt-5 block rounded-full bg-[#172522] px-6 py-4 text-center text-sm font-medium text-white transition hover:bg-[#253935]"
            >
              Book consultation →
            </a>


            <p class="mt-4 text-center text-xs leading-5 text-black/35">
              Your financial profile can be shared with Sarah before
              the appointment so she can prepare.
            </p>

          </div>

        </aside>

      </div>

    </section>


    <!-- SIMILAR ACCOUNTANTS -->
    <section class="border-t border-black/10 bg-[#e9f6e2]">

      <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-10">

        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">

          <div>

            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-black/35">
              Similar accountants
            </p>

            <h2 class="mt-4 text-3xl font-medium tracking-[-0.03em]">
              You may also want to meet
            </h2>

          </div>

          <a href="/matches" class="text-sm font-medium">
            View all →
          </a>

        </div>


        <div class="mt-10 grid gap-5 md:grid-cols-3">

          <!-- DANIEL -->
          <article class="rounded-[24px] bg-white p-6">

            <div class="flex items-center gap-4">

              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#e4e9ff] font-medium">
                DM
              </div>

              <div>
                <h3 class="font-medium">
                  Daniel Morris
                </h3>

                <p class="mt-1 text-xs text-black/45">
                  CA · Registered Tax Agent
                </p>
              </div>

            </div>

            <p class="mt-5 text-sm">
              ★★★★★ 4.8
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                Property
              </span>

              <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                Crypto
              </span>
            </div>

            <div class="mt-6 flex justify-between border-t border-black/10 pt-5 text-sm">
              <span class="text-black/40">
                From $179
              </span>

              <a href="#" class="font-medium">
                View profile →
              </a>
            </div>

          </article>


          <!-- AMELIA -->
          <article class="rounded-[24px] bg-white p-6">

            <div class="flex items-center gap-4">

              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#ffe5d3] font-medium">
                AP
              </div>

              <div>
                <h3 class="font-medium">
                  Amelia Patel
                </h3>

                <p class="mt-1 text-xs text-black/45">
                  CPA · Registered Tax Agent
                </p>
              </div>

            </div>

            <p class="mt-5 text-sm">
              ★★★★★ 5.0
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                Freelancers
              </span>

              <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                Gig workers
              </span>
            </div>

            <div class="mt-6 flex justify-between border-t border-black/10 pt-5 text-sm">
              <span class="text-black/40">
                From $129
              </span>

              <a href="#" class="font-medium">
                View profile →
              </a>
            </div>

          </article>


          <!-- JAMES -->
          <article class="rounded-[24px] bg-white p-6">

            <div class="flex items-center gap-4">

              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#d9ffc5] font-medium">
                JL
              </div>

              <div>
                <h3 class="font-medium">
                  James Liu
                </h3>

                <p class="mt-1 text-xs text-black/45">
                  CA · Registered Tax Agent
                </p>
              </div>

            </div>

            <p class="mt-5 text-sm">
              ★★★★★ 4.9
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                Investors
              </span>

              <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                Shares & ETFs
              </span>
            </div>

            <div class="mt-6 flex justify-between border-t border-black/10 pt-5 text-sm">
              <span class="text-black/40">
                From $159
              </span>

              <a href="#" class="font-medium">
                View profile →
              </a>
            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- FOOTER -->
    <footer class="bg-[#f7f5f0]">

      <div class="mx-auto flex max-w-[1400px] flex-col justify-between gap-4 px-6 py-8 text-xs text-black/40 sm:flex-row lg:px-10">

        <span>
          © 2026 Arc
        </span>

        <span>
          Professional information shown for demonstration purposes.
        </span>

      </div>

    </footer>

  </main>

</Layout>