---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { PATHWAY_STEPS, SHARED_CONTEXT } from "../data/demo-content.mjs";
---

<Layout title="Your Switchpath pathway | Switchpath">
  <main class="page-shell text-[var(--ink)]"><Header />
    <section class="mx-auto max-w-[1280px] px-6 pb-20 pt-12 lg:px-10 lg:pb-28 lg:pt-20">
      <div class="max-w-3xl"><p class="eyebrow">Step 2 of 3 · Your pathway</p><h1 class="section-title mt-5">Here’s who can help, and in what order.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">Based on what you just told us, Switchpath is explaining the questions and sequence. It is not recommending an investment, property, loan, tax structure, or provider as objectively best.</p></div>
      <div class="mt-12 grid gap-8 lg:grid-cols-[1.2fr_.8fr]">
        <section aria-labelledby="pathway-title"><div class="mb-5 flex items-center justify-between"><h2 id="pathway-title" class="text-sm font-bold uppercase tracking-[.15em] text-[var(--muted)]">Your recommended starting point</h2><span id="pathway-summary" class="rounded-full bg-[var(--pale)] px-3 py-1.5 text-xs font-semibold">0 complete · 1 active · 3 previews</span></div><ol class="space-y-3">
          {PATHWAY_STEPS.slice(0, 1).map((step) => <li id={`step-${step.id}`} data-pathway-step={step.id} data-order={step.order} class={`path-card path-card-recommended ${step.order === 1 ? "path-active" : ""}`}><div class="path-marker" aria-hidden="true">{step.order}</div><div class="min-w-0 flex-1"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="step-state-label text-xs font-bold uppercase tracking-[.13em] text-[var(--forest)]">Recommended first conversation</p><h3 class="mt-1 font-serif text-3xl">{step.professional}</h3></div><span class="step-status status-pill">Ready to explore</span></div><p class="mt-5 max-w-2xl leading-7 text-[var(--muted)]"><strong class="text-[var(--ink)]">Why start here:</strong> {step.reason}</p><div class="mt-5 grid gap-4 border-t border-[var(--line)] pt-4 text-sm sm:grid-cols-3"><div><p class="text-xs font-bold uppercase tracking-[.1em] text-[var(--quiet)]">Suggested timing</p><p class="mt-1">{step.timing}</p></div><div><p class="text-xs font-bold uppercase tracking-[.1em] text-[var(--quiet)]">Typical first conversation</p><p class="mt-1">{step.firstConversation}</p></div><div><p class="text-xs font-bold uppercase tracking-[.1em] text-[var(--quiet)]">Next signal</p><p class="mt-1 text-[var(--muted)]">{step.completion}</p></div></div><a href="/marketplace" class="path-action button-primary mt-6 focus-ring">See adviser matches <span aria-hidden="true">↗</span></a></div></li>)}
          <li><details class="pathway-later"><summary class="focus-ring"><span><span class="eyebrow">Optional context</span><strong>What may come later</strong></span><span class="summary-hint">3 possible conversations <span aria-hidden="true">⌄</span></span></summary><ol class="mt-3 space-y-3" aria-label="Possible later pathway steps">{PATHWAY_STEPS.slice(1).map((step) => <li id={`step-${step.id}`} data-pathway-step={step.id} data-order={step.order} class="path-card path-card-preview"><div class="path-marker" aria-hidden="true">{step.order}</div><div class="min-w-0 flex-1"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="step-state-label text-xs font-bold uppercase tracking-[.13em] text-[var(--quiet)]">Future preview</p><h3 class="mt-1 font-serif text-2xl">{step.professional}</h3></div><span class="step-status status-pill">Preview</span></div><p class="mt-4 leading-7 text-[var(--muted)]"><strong class="text-[var(--ink)]">Why later:</strong> {step.reason}</p><div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 border-t border-[var(--line)] pt-4 text-sm"><span><strong>Timing:</strong> {step.timing}</span><span><strong>Typical first conversation:</strong> {step.firstConversation}</span></div><span class="path-action button-secondary mt-5 text-[var(--muted)]">Future preview <span aria-hidden="true">↓</span></span></div></li>)}</ol></details></li>
        </ol></section>
        <aside class="panel h-fit bg-[var(--raised)] p-6 lg:sticky lg:top-6 lg:p-8"><p class="eyebrow">What you shared</p><h2 class="mt-4 font-serif text-3xl">A first plan for new momentum.</h2><ul class="mt-7 space-y-3">{SHARED_CONTEXT.map((item) => <li class="flex gap-3 text-sm leading-6"><span class="text-[#70a052]" aria-hidden="true">●</span><span>{item}</span></li>)}</ul><div class="mt-8 rounded-2xl bg-[var(--pale)] p-5"><p class="text-sm font-semibold">What Switchpath is doing</p><p class="mt-2 text-sm leading-6 text-[var(--muted)]">Turning a broad life event into an order of useful conversations. Your context stays under your control.</p></div><a href="/onboarding" class="mt-6 inline-flex text-sm font-semibold text-[var(--forest)] underline underline-offset-4 focus-ring">← Review your answers</a></aside>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { loadJourney } from "../lib/journey-state.mjs";
  const state = loadJourney();
  const order = { adviser: 1, "mortgage-broker": 2, "tax-accountant": 3, conveyancer: 4 };
  const current = order[state.currentStep] || 1;
  const cards = [...document.querySelectorAll("[data-pathway-step]")];
  const summary = document.querySelector("#pathway-summary");
  const completed = Math.max(0, current - 1); const previews = Math.max(0, cards.length - current);
  summary.textContent = `${completed} complete · 1 active · ${previews} preview${previews === 1 ? "" : "s"}`;
  const replaceAction = (card, stepOrder) => {
    const currentAction = card.querySelector(".path-action");
    const action = document.createElement(stepOrder === 1 && current === 1 ? "a" : "span");
    action.className = `path-action ${stepOrder === 1 && current === 1 ? "button-primary focus-ring" : "button-secondary text-[var(--muted)]"} mt-6`;
    if (stepOrder === 1 && current === 1) { action.href = "/marketplace"; action.textContent = "See adviser matches ↗"; }
    else if (stepOrder < current) action.textContent = "Conversation noted ✓";
    else if (stepOrder === current && stepOrder === 2) action.textContent = "Preview broker questions ↓";
    else if (stepOrder === current) action.textContent = "Preview this step ↓";
    else action.textContent = "Future preview ↓";
    currentAction.replaceWith(action);
  };
  cards.forEach((card) => {
    const stepOrder = Number(card.dataset.order); const label = card.querySelector(".step-state-label"); const status = card.querySelector(".step-status"); const marker = card.querySelector(".path-marker");
    card.classList.toggle("path-active", stepOrder === current);
    if (stepOrder < current) { label.textContent = "Completed"; status.textContent = "Complete"; marker.textContent = "✓"; }
    else if (stepOrder === current) { label.textContent = stepOrder === 1 ? "Recommended first conversation" : "Current step"; status.textContent = "Ready to explore"; marker.textContent = String(stepOrder); }
    else if (stepOrder === current + 1) { label.textContent = "Up next"; status.textContent = "Up next"; marker.textContent = String(stepOrder); }
    else { label.textContent = "Future preview"; status.textContent = "Preview"; marker.textContent = String(stepOrder); }
    replaceAction(card, stepOrder);
  });
</script>
