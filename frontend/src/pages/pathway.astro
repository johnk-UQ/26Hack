---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { PATHWAY_STEPS, SHARED_CONTEXT } from "../data/demo-content.mjs";
---
<Layout title="Your Switchpath pathway | Switchpath"><main class="page-shell text-[var(--ink)]"><Header /><section class="mx-auto max-w-[1280px] px-6 pb-20 pt-12 lg:px-10 lg:pt-20"><div class="max-w-3xl"><p class="eyebrow">Step 2 of 3 · Your pathway</p><h1 class="section-title mt-5">Here’s who can help, and in what order.</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--muted)]">Based on what you just told us, Switchpath is explaining the questions and sequence. It is not recommending an investment, property, loan, tax structure, or provider as objectively best.</p></div><div class="mt-12 grid gap-8 lg:grid-cols-[1.2fr_.8fr]"><section aria-labelledby="pathway-title"><div class="mb-5 flex items-center justify-between"><h2 id="pathway-title" class="text-sm font-bold uppercase tracking-[.15em] text-[var(--muted)]">Your recommended starting point</h2><span id="pathway-summary" class="rounded-full bg-[var(--pale)] px-3 py-1.5 text-xs font-semibold">0 complete · 1 active · 3 previews</span></div><ol id="pathway-cards" class="space-y-3">{PATHWAY_STEPS.slice(0, 1).map((step) => <li data-pathway-step={step.id} data-order={step.order} class="path-card path-card-recommended path-active"><div class="path-marker">{step.order}</div><div class="min-w-0 flex-1"><p class="text-xs font-bold uppercase tracking-[.13em]">Recommended first conversation</p><h3 class="mt-1 font-serif text-3xl">{step.professional}</h3><p class="mt-5 leading-7 text-[var(--muted)]"><strong class="text-[var(--ink)]">Why start here:</strong> {step.reason}</p><div class="mt-5 grid gap-4 border-t border-[var(--line)] pt-4 text-sm sm:grid-cols-3"><div><p class="text-xs text-[var(--quiet)]">Suggested timing</p><p class="mt-1">{step.timing}</p></div><div><p class="text-xs text-[var(--quiet)]">Typical first conversation</p><p class="mt-1">{step.firstConversation}</p></div><div><p class="text-xs text-[var(--quiet)]">Next signal</p><p class="mt-1">{step.completion}</p></div></div><a href="/marketplace" class="path-action button-primary mt-6 focus-ring">See matches ↗</a></div></li>)}</ol></section><aside class="panel h-fit bg-[var(--raised)] p-6 lg:sticky lg:top-6 lg:p-8"><p class="eyebrow">What you shared</p><h2 id="context-headline" class="mt-4 font-serif text-3xl">A first plan for new momentum.</h2><ul id="context-list" class="mt-7 space-y-3">{SHARED_CONTEXT.map((item) => <li class="flex gap-3 text-sm leading-6"><span class="text-[#70a052]">●</span><span>{item}</span></li>)}</ul><div class="mt-8 rounded-2xl bg-[var(--pale)] p-5"><p class="text-sm font-semibold">What Switchpath is doing</p><p class="mt-2 text-sm leading-6 text-[var(--muted)]">Turning a broad life event into an order of useful conversations. Your context stays under your control.</p></div><a href="/onboarding" class="mt-6 inline-flex text-sm font-semibold text-[var(--forest)] underline underline-offset-4 focus-ring">← Review your answers</a></aside></div></section></main></Layout>
<script>
  import { loadJourney } from "../lib/journey-state.mjs";
  const state = loadJourney(); const rawSteps = Array.isArray(state.generatedPathway) && state.generatedPathway.length ? state.generatedPathway : null; const root = document.querySelector("#pathway-cards");
  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character]);
  const id = (role) => role.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  const steps = rawSteps?.map((step) => Object.fromEntries(Object.entries(step).map(([key, value]) => [key, typeof value === "string" ? escapeHtml(value) : value])));
  const card = (step, index) => { const li = document.createElement("li"); li.className = `path-card ${index ? "path-card-preview" : "path-card-recommended path-active"}`; li.dataset.pathwayStep = id(step.professional); li.dataset.order = step.order; li.innerHTML = `<div class="path-marker">${step.order}</div><div class="min-w-0 flex-1"><p class="text-xs font-bold uppercase tracking-[.13em]">${index ? "Future preview" : "Recommended first conversation"}</p><h3 class="mt-1 font-serif ${index ? "text-2xl" : "text-3xl"}">${step.professional}</h3><p class="mt-5 leading-7 text-[var(--muted)]"><strong class="text-[var(--ink)]">${index ? "Why later:" : "Why start here:"}</strong> ${step.reason}</p><div class="mt-5 grid gap-4 border-t border-[var(--line)] pt-4 text-sm sm:grid-cols-3"><div><p class="text-xs text-[var(--quiet)]">Suggested timing</p><p class="mt-1">${step.timing}</p></div><div><p class="text-xs text-[var(--quiet)]">Completion signal</p><p class="mt-1">${step.completion}</p></div></div>${index ? `<span class="path-action button-secondary mt-6 text-[var(--muted)]">Future preview ↓</span>` : `<a href="/marketplace" class="path-action button-primary mt-6 focus-ring">See ${step.professional} matches ↗</a>`}</div>`; return li; };
  if (steps) { root.replaceChildren(...steps.map(card)); const summary = state.generatedSummary; if (summary?.headline) document.querySelector("#context-headline").textContent = summary.headline; if (Array.isArray(summary?.context)) document.querySelector("#context-list").replaceChildren(...summary.context.map((item) => { const li = document.createElement("li"); li.className = "flex gap-3 text-sm leading-6"; li.innerHTML = `<span class="text-[#70a052]">●</span><span>${item}</span>`; return li; })); }
  if (steps && steps.length > 1) { const later = [...root.children].slice(1); const details = document.createElement("details"); details.className = "pathway-later"; const summary = document.createElement("summary"); summary.className = "focus-ring"; summary.textContent = "What may come later"; const list = document.createElement("ol"); list.className = "mt-3 space-y-3"; list.append(...later); details.append(summary, list); root.append(details); }
  const rendered = [...document.querySelectorAll("[data-pathway-step]")]; const completed = Number.isFinite(Number(state.currentStep)) ? Math.max(0, Number(state.currentStep) - 1) : 0; document.querySelector("#pathway-summary").textContent = `${completed} complete · 1 active · ${Math.max(0, rendered.length - 1)} preview${rendered.length === 2 ? "" : "s"}`;
</script>
