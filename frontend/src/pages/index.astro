---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Arc | Find the right professional">
  <main class="bg-[#f7f5f0] text-[#18201f]">

    <!-- NAV -->
    <header class="border-b border-black/10 bg-[#f7f5f0]">
      <nav class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-5 lg:px-10">

        <a href="/" class="text-2xl font-semibold tracking-[-0.04em]">
          arc
        </a>

        <div class="hidden items-center gap-8 text-sm md:flex">
          <a href="#how-it-works" class="transition hover:opacity-50">
            How it works
          </a>

          <a href="#reasons" class="transition hover:opacity-50">
            What we help with
          </a>

          <a href="/professionals" class="transition hover:opacity-50">
            Browse professionals
          </a>

          <a href="#for-professionals" class="transition hover:opacity-50">
            For professionals
          </a>
        </div>

        <div class="flex items-center gap-5">
          <a href="#" class="hidden text-sm sm:block">
            Sign in
          </a>

          <a
            href="/intake"
            class="rounded-full bg-[#172522] px-5 py-3 text-sm font-medium text-white transition hover:bg-[#253935]"
          >
            Get matched
          </a>
        </div>

      </nav>
    </header>


    <!-- HERO -->
    <section class="overflow-hidden">

      <div class="mx-auto grid max-w-[1400px] gap-14 px-6 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:py-28">

        <!-- LEFT -->
        <div class="flex flex-col justify-center">

          

          <h1 class="max-w-4xl text-5xl font-medium leading-[1.02] tracking-[-0.05em] sm:text-6xl lg:text-[78px]">
            Find the right professional for your financial life.
          </h1>

          <p class="mt-7 max-w-2xl text-lg leading-8 text-black/60 sm:text-xl">
            Tell us what's happening with your money. We'll help understand
            what you need and connect you with professionals who specialise
            in your situation.
          </p>

          <div class="mt-9 flex flex-wrap gap-3">

            <a
              href="/intake"
              class="rounded-full bg-[#172522] px-7 py-4 text-sm font-medium text-white transition hover:bg-[#253935]"
            >
              Find my professional →
            </a>

            <a
              href="/professionals"
              class="rounded-full border border-black/15 bg-white px-7 py-4 text-sm font-medium transition hover:bg-black/5"
            >
              Browse professionals
            </a>

          </div>

         

        </div>


        <!-- RIGHT: INTAKE PREVIEW -->
        <div class="relative flex items-center justify-center">

          <div class="absolute right-0 top-8 h-56 w-56 rounded-full bg-[#d9ffc5] blur-3xl"></div>

          <div class="relative w-full max-w-[560px] rounded-[28px] border border-black/10 bg-white p-5 shadow-[0_28px_70px_rgba(25,35,32,0.10)] sm:p-7">

            <div class="flex items-center justify-between border-b border-black/10 pb-5">

              <div>
                <p class="text-sm font-medium">
                  What can we help you with?
                </p>

                <p class="mt-1 text-xs text-black/40">
                  You don't need to know the accounting terminology.
                </p>
              </div>

              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#d9ffc5] font-semibold">
                A
              </div>

            </div>


            <div class="space-y-5 py-6">

              <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-[#f2f0eb] px-4 py-3 text-sm leading-6">
                Tell me what's happening with your finances and I'll help
                figure out what kind of accounting support might be useful.
              </div>

              <div class="ml-auto max-w-[88%] rounded-2xl rounded-tr-sm bg-[#172522] px-4 py-3 text-sm leading-6 text-white">
                I started my first full-time job this year, bought some ETFs,
                have a little crypto and also made about $4,000 freelancing.
              </div>

              <div class="max-w-[88%] rounded-2xl rounded-tl-sm bg-[#f2f0eb] px-4 py-3 text-sm leading-6">
                Got it. You may need help with an individual tax return,
                investment income, capital gains and freelance income.
              </div>

            </div>


            <div class="rounded-2xl border border-black/10 bg-[#fbfaf7] p-4">

              <p class="text-xs font-medium uppercase tracking-[0.15em] text-black/35">
                Your situation
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-full bg-white px-3 py-1.5 text-xs ring-1 ring-black/10">
                  PAYG employee
                </span>

                <span class="rounded-full bg-white px-3 py-1.5 text-xs ring-1 ring-black/10">
                  ETFs
                </span>

                <span class="rounded-full bg-white px-3 py-1.5 text-xs ring-1 ring-black/10">
                  Crypto
                </span>

                <span class="rounded-full bg-white px-3 py-1.5 text-xs ring-1 ring-black/10">
                  Freelance income
                </span>
              </div>

            </div>


            <div class="mt-5 flex items-center gap-3 rounded-2xl border border-black/10 px-4 py-3">

              <input
                type="text"
                placeholder="Tell us what's going on..."
                class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-black/30"
              />

              <button class="flex h-10 w-10 items-center justify-center rounded-full bg-[#172522] text-white">
                →
              </button>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- TRUST STRIP -->
    <section class="border-y border-black/10 bg-[#172522] text-white">

      <div class="mx-auto grid max-w-[1400px] gap-6 px-6 py-7 text-center text-sm sm:grid-cols-3 lg:px-10">

        <div>
          <span class="text-white/45">01</span>
          <span class="ml-3">Explain your situation normally</span>
        </div>

        <div>
          <span class="text-white/45">02</span>
          <span class="ml-3">We identify what help you need</span>
        </div>

        <div>
          <span class="text-white/45">03</span>
          <span class="ml-3">Compare matched professionals</span>
        </div>

      </div>

    </section>


    <!-- HOW IT WORKS -->
    <section id="how-it-works">

      <div class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10">

        <div class="max-w-2xl">

          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black/45">
            How it works
          </p>

          <h2 class="mt-4 text-4xl font-medium tracking-[-0.04em] sm:text-5xl">
            You describe your life. We help find the specialist.
          </h2>

        </div>


        <div class="mt-14 grid gap-5 md:grid-cols-3">

          <div class="rounded-[24px] border border-black/10 bg-white p-7">

            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#d9ffc5] text-sm font-semibold">
              1
            </div>

            <h3 class="mt-8 text-2xl font-medium tracking-[-0.03em]">
              Tell us what's going on
            </h3>

            <p class="mt-4 leading-7 text-black/55">
              Describe your financial situation naturally — your job,
              investments, side income, property or whatever is relevant.
            </p>

            <div class="mt-8 rounded-2xl bg-[#f6f4ef] p-4 text-sm italic leading-6 text-black/60">
              “I started a graduate job, have ETFs and do some freelance work.”
            </div>

          </div>


          <div class="rounded-[24px] border border-black/10 bg-white p-7">

            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#d9ffc5] text-sm font-semibold">
              2
            </div>

            <h3 class="mt-8 text-2xl font-medium tracking-[-0.03em]">
              We understand what you need
            </h3>

            <p class="mt-4 leading-7 text-black/55">
              AI structures your situation and identifies the accounting
              areas that may be relevant.
            </p>

            <div class="mt-8 flex flex-wrap gap-2">
              <span class="rounded-full bg-[#f6f4ef] px-3 py-2 text-xs">
                Individual tax
              </span>

              <span class="rounded-full bg-[#f6f4ef] px-3 py-2 text-xs">
                Investment income
              </span>

              <span class="rounded-full bg-[#f6f4ef] px-3 py-2 text-xs">
                Freelancing
              </span>
            </div>

          </div>


          <div class="rounded-[24px] border border-black/10 bg-white p-7">

            <div class="flex h-11 w-11 items-center justify-center rounded-full bg-[#d9ffc5] text-sm font-semibold">
              3
            </div>

            <h3 class="mt-8 text-2xl font-medium tracking-[-0.03em]">
              Meet professionals that fit
            </h3>

            <p class="mt-4 leading-7 text-black/55">
              Compare professionals by expertise, pricing, reviews,
              availability and how closely they match your situation.
            </p>

            <a
              href="/intake"
              class="mt-8 inline-flex items-center gap-2 text-sm font-medium"
            >
              Get matched
              <span>→</span>
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- COMMON REASONS -->
    <section id="reasons" class="border-y border-black/10 bg-[#e9f6e2]">

      <div class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10">

        <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr]">

          <div>

            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black/45">
              What can we help with?
            </p>

            <h2 class="mt-4 text-4xl font-medium tracking-[-0.04em] sm:text-5xl">
              Accounting usually starts with a life event.
            </h2>

            <p class="mt-5 max-w-md leading-7 text-black/55">
              Start with what's happening in your life. We'll help work out
              the accounting from there.
            </p>

          </div>


          <div class="grid gap-3 sm:grid-cols-2">

            <a href="/intake" class="group rounded-[20px] bg-white p-6 transition hover:-translate-y-1">

              <p class="text-lg font-medium">
                I started my first job
              </p>

              <p class="mt-2 text-sm leading-6 text-black/50">
                Tax returns, deductions, investments and understanding your finances.
              </p>

              <p class="mt-6 text-sm">
                Start here →
              </p>

            </a>


            <a href="/intake" class="group rounded-[20px] bg-white p-6 transition hover:-translate-y-1">

              <p class="text-lg font-medium">
                I started investing
              </p>

              <p class="mt-2 text-sm leading-6 text-black/50">
                Shares, ETFs, dividends, capital gains and investment reporting.
              </p>

              <p class="mt-6 text-sm">
                Start here →
              </p>

            </a>


            <a href="/intake" class="group rounded-[20px] bg-white p-6 transition hover:-translate-y-1">

              <p class="text-lg font-medium">
                I have a side hustle
              </p>

              <p class="mt-2 text-sm leading-6 text-black/50">
                Freelance income, ABNs, expenses, deductions and tax planning.
              </p>

              <p class="mt-6 text-sm">
                Start here →
              </p>

            </a>


            <a href="/intake" class="group rounded-[20px] bg-white p-6 transition hover:-translate-y-1">

              <p class="text-lg font-medium">
                I own crypto
              </p>

              <p class="mt-2 text-sm leading-6 text-black/50">
                Crypto transactions, disposal events and capital gains.
              </p>

              <p class="mt-6 text-sm">
                Start here →
              </p>

            </a>


            <a href="/intake" class="group rounded-[20px] bg-white p-6 transition hover:-translate-y-1">

              <p class="text-lg font-medium">
                I bought an investment property
              </p>

              <p class="mt-2 text-sm leading-6 text-black/50">
                Rental income, expenses, depreciation and property tax.
              </p>

              <p class="mt-6 text-sm">
                Start here →
              </p>

            </a>


            <a href="/intake" class="group rounded-[20px] bg-white p-6 transition hover:-translate-y-1">

              <p class="text-lg font-medium">
                I do gig work
              </p>

              <p class="mt-2 text-sm leading-6 text-black/50">
                Rideshare, delivery and contractor income made easier to understand.
              </p>

              <p class="mt-6 text-sm">
                Start here →
              </p>

            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- BENEFITS -->
    <section>

      <div class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10">

        <div class="text-center">

          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black/45">
            Why Arc?
          </p>

          <h2 class="mx-auto mt-4 max-w-2xl text-4xl font-medium tracking-[-0.04em] sm:text-5xl">
            Less searching. Less jargon. Better prepared.
          </h2>

        </div>


        <div class="mt-14 grid gap-px overflow-hidden rounded-[24px] border border-black/10 bg-black/10 sm:grid-cols-2 lg:grid-cols-4">

          <div class="bg-white p-7">
            <p class="text-sm font-medium">
              Matched to your situation
            </p>

            <p class="mt-3 text-sm leading-6 text-black/50">
              Not every professional specialises in the same things.
            </p>
          </div>

          <div class="bg-white p-7">
            <p class="text-sm font-medium">
              Know the price upfront
            </p>

            <p class="mt-3 text-sm leading-6 text-black/50">
              Compare consultation and service pricing before you book.
            </p>
          </div>

          <div class="bg-white p-7">
            <p class="text-sm font-medium">
              Skip the jargon
            </p>

            <p class="mt-3 text-sm leading-6 text-black/50">
              Tell us what's happening in normal language.
            </p>
          </div>

          <div class="bg-white p-7">
            <p class="text-sm font-medium">
              Everything organised
            </p>

            <p class="mt-3 text-sm leading-6 text-black/50">
              Keep your situation, questions and documents together.
            </p>
          </div>

        </div>

      </div>

    </section>


    <!-- FEATURED professionalS -->
    <section id="professionals" class="border-y border-black/10 bg-white">

      <div class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10">

        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">

          <div>

            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-black/45">
              Featured professionals
            </p>

            <h2 class="mt-4 text-4xl font-medium tracking-[-0.04em] sm:text-5xl">
              Find someone who understands your situation.
            </h2>

          </div>

          <a href="/professionals" class="text-sm font-medium">
            View all professionals →
          </a>

        </div>


        <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">

          <!-- professional 1 -->
          <article class="rounded-[24px] border border-black/10 p-6">

            <div class="flex items-start gap-4">

              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-[#d9ffc5] text-lg font-semibold">
                SC
              </div>

              <div>

                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-medium">
                    Sarah Chen
                  </h3>

                  <span class="rounded-full bg-[#e9f6e2] px-2 py-1 text-[10px] font-medium">
                    VERIFIED
                  </span>
                </div>

                <p class="mt-1 text-sm text-black/45">
                  CPA · Registered Tax Agent
                </p>

              </div>

            </div>


            <div class="mt-6 flex items-center gap-2 text-sm">
              <span>★★★★★</span>
              <span class="font-medium">4.9</span>
              <span class="text-black/35">(128 reviews)</span>
            </div>


            <div class="mt-6">

              <p class="text-xs uppercase tracking-[0.15em] text-black/35">
                Specialises in
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Young professionals
                </span>

                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Shares & ETFs
                </span>

                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Side hustles
                </span>
              </div>

            </div>


            <div class="mt-7 grid grid-cols-2 border-t border-black/10 pt-5">

              <div>
                <p class="text-xs text-black/35">
                  From
                </p>

                <p class="mt-1 text-lg font-medium">
                  $149
                </p>
              </div>

              <div>
                <p class="text-xs text-black/35">
                  Next available
                </p>

                <p class="mt-1 text-sm font-medium">
                  Today · 5:30 PM
                </p>
              </div>

            </div>


            <a
              href="/professional/sarah-chen"
              class="mt-6 block rounded-full bg-[#172522] px-5 py-3 text-center text-sm font-medium text-white"
            >
              View profile
            </a>

          </article>


          <!-- professional 2 -->
          <article class="rounded-[24px] border border-black/10 p-6">

            <div class="flex items-start gap-4">

              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-[#e4e9ff] text-lg font-semibold">
                DM
              </div>

              <div>

                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-medium">
                    Daniel Morris
                  </h3>

                  <span class="rounded-full bg-[#e9f6e2] px-2 py-1 text-[10px] font-medium">
                    VERIFIED
                  </span>
                </div>

                <p class="mt-1 text-sm text-black/45">
                  CA · Registered Tax Agent
                </p>

              </div>

            </div>


            <div class="mt-6 flex items-center gap-2 text-sm">
              <span>★★★★★</span>
              <span class="font-medium">4.8</span>
              <span class="text-black/35">(94 reviews)</span>
            </div>


            <div class="mt-6">

              <p class="text-xs uppercase tracking-[0.15em] text-black/35">
                Specialises in
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Property
                </span>

                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Crypto
                </span>

                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Investors
                </span>
              </div>

            </div>


            <div class="mt-7 grid grid-cols-2 border-t border-black/10 pt-5">

              <div>
                <p class="text-xs text-black/35">
                  From
                </p>

                <p class="mt-1 text-lg font-medium">
                  $179
                </p>
              </div>

              <div>
                <p class="text-xs text-black/35">
                  Next available
                </p>

                <p class="mt-1 text-sm font-medium">
                  Tomorrow · 10:00 AM
                </p>
              </div>

            </div>


            <a
              href="/professional/daniel-morris"
              class="mt-6 block rounded-full bg-[#172522] px-5 py-3 text-center text-sm font-medium text-white"
            >
              View profile
            </a>

          </article>


          <!-- professional 3 -->
          <article class="rounded-[24px] border border-black/10 p-6">

            <div class="flex items-start gap-4">

              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-[#ffe5d3] text-lg font-semibold">
                AP
              </div>

              <div>

                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-medium">
                    Amelia Patel
                  </h3>

                  <span class="rounded-full bg-[#e9f6e2] px-2 py-1 text-[10px] font-medium">
                    VERIFIED
                  </span>
                </div>

                <p class="mt-1 text-sm text-black/45">
                  CPA · Registered Tax Agent
                </p>

              </div>

            </div>


            <div class="mt-6 flex items-center gap-2 text-sm">
              <span>★★★★★</span>
              <span class="font-medium">5.0</span>
              <span class="text-black/35">(71 reviews)</span>
            </div>


            <div class="mt-6">

              <p class="text-xs uppercase tracking-[0.15em] text-black/35">
                Specialises in
              </p>

              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Freelancers
                </span>

                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Gig workers
                </span>

                <span class="rounded-full bg-[#f5f3ef] px-3 py-1.5 text-xs">
                  Individual tax
                </span>
              </div>

            </div>


            <div class="mt-7 grid grid-cols-2 border-t border-black/10 pt-5">

              <div>
                <p class="text-xs text-black/35">
                  From
                </p>

                <p class="mt-1 text-lg font-medium">
                  $129
                </p>
              </div>

              <div>
                <p class="text-xs text-black/35">
                  Next available
                </p>

                <p class="mt-1 text-sm font-medium">
                  Today · 7:00 PM
                </p>
              </div>

            </div>


            <a
              href="/professional/amelia-patel"
              class="mt-6 block rounded-full bg-[#172522] px-5 py-3 text-center text-sm font-medium text-white"
            >
              View profile
            </a>

          </article>

        </div>

      </div>

    </section>


    <!-- professional VALUE PROP -->
    <section id="for-professionals" class="bg-[#172522] text-white">

      <div class="mx-auto grid max-w-[1400px] gap-12 px-6 py-24 lg:grid-cols-2 lg:px-10">

        <div>

          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/40">
            For professionals
          </p>

          <h2 class="mt-4 max-w-xl text-4xl font-medium tracking-[-0.04em] sm:text-5xl">
            Spend less time qualifying leads.
          </h2>

        </div>


        <div>

          <p class="max-w-xl text-lg leading-8 text-white/60">
            Receive prepared client enquiries with their situation already
            structured, expected service identified and documents organised
            before the first conversation.
          </p>

          <p class="mt-7 text-2xl font-medium leading-9">
            Spend more time doing accounting work.
          </p>

          <a
            href="#"
            class="mt-8 inline-flex rounded-full bg-[#d9ffc5] px-6 py-3.5 text-sm font-medium text-[#172522]"
          >
            Join as an professional →
          </a>

        </div>

      </div>

    </section>


    <!-- FINAL CTA -->
    <section class="bg-[#d9ffc5]">

      <div class="mx-auto max-w-[1400px] px-6 py-24 text-center lg:px-10">

        <h2 class="mx-auto max-w-4xl text-5xl font-medium leading-[1.03] tracking-[-0.045em] sm:text-6xl">
          Finding an professional shouldn't require understanding accounting.
        </h2>

        <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-black/55">
          Tell us what's happening with your money and we'll help you
          find someone who understands it.
        </p>

        <a
          href="/intake"
          class="mt-9 inline-flex rounded-full bg-[#172522] px-7 py-4 text-sm font-medium text-white"
        >
          Find my professional →
        </a>

      </div>

    </section>


