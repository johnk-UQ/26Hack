---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Arc | Private Markets">
  <main class="bg-[#f4f1ea] text-[#171717]">

    <!-- NAVIGATION -->
    <header class="border-b border-black/10">
      <nav class="mx-auto flex max-w-[1500px] items-center justify-between px-6 py-6 lg:px-10">

        <a href="/" class="text-2xl font-semibold tracking-[-0.04em]">
          arc
        </a>

        <div class="hidden items-center gap-9 text-sm md:flex">
          <a href="#discover" class="hover:opacity-60">
            Discover
          </a>

          <a href="#how-it-works" class="hover:opacity-60">
            How it works
          </a>

          <a href="#markets" class="hover:opacity-60">
            Private markets
          </a>

          <a href="#learn" class="hover:opacity-60">
            Learn
          </a>
        </div>

        <div class="flex items-center gap-5">
          <a
            href="/marketplace"
            class="hidden text-sm md:block"
          >
            Explore
          </a>

          <a
            href="/onboarding"
            class="rounded-full bg-black px-6 py-3 text-sm font-medium text-white transition hover:bg-black/80"
          >
            Get started
          </a>
        </div>

      </nav>
    </header>


    <!-- HERO -->
    <section class="border-b border-black/10">

      <div class="mx-auto max-w-[1500px] px-6 pb-20 pt-24 lg:px-10 lg:pb-28 lg:pt-32">

        <div class="max-w-[1150px]">

          <p class="mb-8 text-xs font-semibold uppercase tracking-[0.2em]">
            Private markets. Made understandable.
          </p>

          <h1
            class="text-[64px] font-medium leading-[0.96] tracking-[-0.055em] sm:text-[82px] lg:text-[112px]"
          >
            Discover private markets
            <span class="text-[#77746d]">
              built around you.
            </span>
          </h1>

        </div>


        <div class="mt-14 grid gap-10 lg:grid-cols-2">

          <p class="max-w-xl text-xl leading-8 text-[#55524d]">
            Explore private equity, infrastructure, private credit and
            real assets — matched to your stated goals and explained
            in plain English.
          </p>


          <div class="flex flex-col items-start lg:items-end">

            <a
              href="/onboarding"
              class="inline-flex items-center gap-4 rounded-full bg-black px-8 py-4 text-sm font-medium text-white transition hover:bg-black/80"
            >
              Build your investor profile

              <span class="text-lg">
                →
              </span>
            </a>

            <p class="mt-4 text-xs text-[#77746d]">
              Free to explore · About 2 minutes
            </p>

          </div>

        </div>

      </div>

    </section>

	<!-- FUND MANAGER MARQUEE -->
	<section class="overflow-hidden border-b border-black/10 bg-[#d8ff75] py-10 text-black">

		<div class="mx-auto max-w-[1500px] px-6 lg:px-10">
		<p class="mb-8 text-center text-xs font-medium uppercase tracking-[0.2em] text-black/50">
		Illustrative managers available for discovery
		</p>
	</div>

	<!-- Moving logo/name track -->
	<div class="marquee">
		<div class="marquee-track">

		<!-- First copy -->
		<div class="manager">BLACKSTONE</div>
		<div class="manager serif">KKR</div>
		<div class="manager">APOLLO</div>
		<div class="manager serif">Brookfield</div>
		<div class="manager">EQT</div>
		<div class="manager serif">Carlyle</div>
		<div class="manager">MACQUARIE</div>
		<div class="manager serif">Partners Group</div>
		<div class="manager">CVC</div>
		<div class="manager serif">Warburg Pincus</div>
		<div class="manager">IFM INVESTORS</div>

		<!-- Duplicate copy for seamless animation -->
		<div class="manager">BLACKSTONE</div>
		<div class="manager serif">KKR</div>
		<div class="manager">APOLLO</div>
		<div class="manager serif">Brookfield</div>
		<div class="manager">EQT</div>
		<div class="manager serif">Carlyle</div>
		<div class="manager">MACQUARIE</div>
		<div class="manager serif">Partners Group</div>
		<div class="manager">CVC</div>
		<div class="manager serif">Warburg Pincus</div>
		<div class="manager">IFM INVESTORS</div>

		</div>
	</div>

	</section>
	
    <!-- INTRO -->
    <section
      id="discover"
      class="border-b border-black/10"
    >
      <div class="mx-auto max-w-[1500px] px-6 py-24 lg:px-10 lg:py-32">

        <div class="grid gap-16 lg:grid-cols-[0.7fr_1.3fr]">

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em]">
              Private markets, differently
            </p>
          </div>


          <div class="max-w-4xl">

            <h2
              class="text-4xl font-medium leading-[1.08] tracking-[-0.035em] sm:text-5xl lg:text-6xl"
            >
              Opportunities that were once difficult to find,
              made easier to discover and understand.
            </h2>

            <p class="mt-8 max-w-2xl text-lg leading-8 text-[#69665f]">
              Arc helps you navigate private market investments by turning
              your goals, risk preferences and investment horizon into a
              clear profile — then showing opportunities aligned with what
              you told us.
            </p>

          </div>

        </div>

      </div>
    </section>


	
    <!-- MATCH PREVIEW -->
    <section class="border-b border-black/10 bg-[#ebe7df]">

      <div class="mx-auto max-w-[1500px] px-6 py-24 lg:px-10 lg:py-32">

        <div class="mb-14 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em]">
              Personalised discovery
            </p>

            <h2
              class="mt-5 max-w-3xl text-4xl font-medium tracking-[-0.04em] sm:text-5xl"
            >
              See why an opportunity matches your preferences.
            </h2>
          </div>

          <a
            href="/marketplace"
            class="text-sm underline underline-offset-4"
          >
            Explore opportunities
          </a>

        </div>


        <!-- Fund card -->
        <div class="overflow-hidden rounded-[2px] bg-[#171717] text-white">

          <div class="grid lg:grid-cols-[1.3fr_0.7fr]">

            <div class="p-8 sm:p-12 lg:p-16">

              <div class="flex flex-wrap items-center gap-3">

                <span
                  class="rounded-full border border-white/30 px-3 py-1 text-xs"
                >
                  Infrastructure
                </span>

                <span
                  class="rounded-full bg-[#d9ff77] px-3 py-1 text-xs font-medium text-black"
                >
                  96% match
                </span>

              </div>

              <h3
                class="mt-10 max-w-2xl text-4xl font-medium leading-tight tracking-[-0.035em] sm:text-5xl"
              >
                Australian Digital Infrastructure Fund
              </h3>

              <p
                class="mt-6 max-w-xl text-lg leading-8 text-white/60"
              >
                Exposure to data centres, fibre networks and renewable
                energy infrastructure supporting Australia's digital economy.
              </p>


              <div class="mt-12 grid grid-cols-2 gap-8 sm:grid-cols-4">

                <div>
                  <p class="text-xs uppercase tracking-wider text-white/40">
                    Minimum
                  </p>
                  <p class="mt-2 text-lg">$2,000</p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-wider text-white/40">
                    Horizon
                  </p>
                  <p class="mt-2 text-lg">8–12 yrs</p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-wider text-white/40">
                    Risk
                  </p>
                  <p class="mt-2 text-lg">High</p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-wider text-white/40">
                    Liquidity
                  </p>
                  <p class="mt-2 text-lg">Low</p>
                </div>

              </div>

            </div>


            <!-- Match explanation -->
            <div class="border-t border-white/15 bg-[#222222] p-8 sm:p-12 lg:border-l lg:border-t-0 lg:p-14">

              <p class="text-xs uppercase tracking-[0.2em] text-white/40">
                Why it matches you
              </p>

              <div class="mt-8 space-y-7">

                <div class="flex gap-4">
                  <span>✓</span>

                  <p class="text-sm leading-6 text-white/80">
                    Your long investment horizon aligns with the fund's
                    expected holding period.
                  </p>
                </div>

                <div class="flex gap-4">
                  <span>✓</span>

                  <p class="text-sm leading-6 text-white/80">
                    You indicated a high preference for long-term growth.
                  </p>
                </div>

                <div class="flex gap-4">
                  <span>✓</span>

                  <p class="text-sm leading-6 text-white/80">
                    Digital infrastructure and renewable energy match
                    your selected themes.
                  </p>
                </div>

              </div>


              <a
                href="/fund"
                class="mt-12 inline-flex items-center gap-3 text-sm font-medium"
              >
                View opportunity
                <span>→</span>
              </a>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- HOW IT WORKS -->
    <section
      id="how-it-works"
      class="border-b border-black/10 bg-[#f4f1ea]"
    >

      <div class="mx-auto max-w-[1500px] px-6 py-24 lg:px-10 lg:py-32">

        <div class="grid gap-16 lg:grid-cols-[0.8fr_1.2fr]">

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em]">
              How it works
            </p>

            <h2
              class="mt-5 max-w-lg text-5xl font-medium leading-[1.05] tracking-[-0.04em]"
            >
              Understand first.
              Discover second.
            </h2>
          </div>


          <div>

            <!-- Step -->
            <div class="border-t border-black/20 py-8">
              <div class="grid gap-5 sm:grid-cols-[60px_1fr]">

                <span class="text-sm text-[#77746d]">
                  01
                </span>

                <div>
                  <h3 class="text-2xl font-medium">
                    Tell us what matters to you
                  </h3>

                  <p class="mt-3 max-w-xl leading-7 text-[#69665f]">
                    Share your goals, investment horizon, risk tolerance,
                    liquidity needs and areas of interest.
                  </p>
                </div>

              </div>
            </div>


            <!-- Step -->
            <div class="border-t border-black/20 py-8">
              <div class="grid gap-5 sm:grid-cols-[60px_1fr]">

                <span class="text-sm text-[#77746d]">
                  02
                </span>

                <div>
                  <h3 class="text-2xl font-medium">
                    Build your investor profile
                  </h3>

                  <p class="mt-3 max-w-xl leading-7 text-[#69665f]">
                    AI interprets your answers and creates a simple,
                    understandable profile.
                  </p>
                </div>

              </div>
            </div>


            <!-- Step -->
            <div class="border-y border-black/20 py-8">
              <div class="grid gap-5 sm:grid-cols-[60px_1fr]">

                <span class="text-sm text-[#77746d]">
                  03
                </span>

                <div>
                  <h3 class="text-2xl font-medium">
                    Discover relevant opportunities
                  </h3>

                  <p class="mt-3 max-w-xl leading-7 text-[#69665f]">
                    Compare opportunities and understand why each one
                    does — or doesn't — align with your preferences.
                  </p>
                </div>

              </div>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- EDUCATION -->
    <section id="learn" class="bg-white">

      <div class="mx-auto max-w-[1500px] px-6 py-24 lg:px-10 lg:py-32">

        <div class="grid gap-10 lg:grid-cols-2">

          <div
            class="flex min-h-[460px] flex-col justify-between bg-[#d8ff75] p-8 sm:p-12"
          >

            <div>
              <p class="text-xs uppercase tracking-[0.2em]">
                AI Fund Explainer
              </p>

              <h2
                class="mt-6 max-w-lg text-4xl font-medium tracking-[-0.04em] sm:text-5xl"
              >
                Private market language, without the jargon.
              </h2>
            </div>

            <p class="max-w-md text-lg leading-8">
              Understand carried interest, hurdle rates, capital calls,
              IRR, DPI and other terms in plain English.
            </p>

          </div>


          <div
            class="flex min-h-[460px] flex-col justify-between bg-[#262626] p-8 text-white sm:p-12"
          >

            <div>
              <p class="text-xs uppercase tracking-[0.2em] text-white/50">
                Eligibility
              </p>

              <h2
                class="mt-6 max-w-lg text-4xl font-medium tracking-[-0.04em] sm:text-5xl"
              >
                Know what you can actually access.
              </h2>
            </div>

            <p class="max-w-md text-lg leading-8 text-white/60">
              Clearly distinguish opportunities available to retail
              investors from those restricted to wholesale or
              sophisticated investors.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- FINAL CTA -->
    <section class="bg-[#171717] text-white">

      <div class="mx-auto max-w-[1500px] px-6 py-24 lg:px-10 lg:py-32">

        <p class="text-xs uppercase tracking-[0.2em] text-white/50">
          Start exploring
        </p>

        <div class="mt-8 flex flex-col justify-between gap-12 lg:flex-row lg:items-end">

          <h2
            class="max-w-4xl text-5xl font-medium leading-[1.02] tracking-[-0.045em] sm:text-6xl lg:text-7xl"
          >
            Find private-market opportunities aligned with what matters to you.
          </h2>

          <a
            href="/onboarding"
            class="shrink-0 rounded-full bg-[#d8ff75] px-8 py-4 text-sm font-medium text-black transition hover:opacity-80"
          >
            Build your profile →
          </a>

        </div>

      </div>

    </section>


    <!-- FOOTER -->
    <footer class="bg-[#171717] text-white">

      <div class="mx-auto max-w-[1500px] border-t border-white/15 px-6 py-10 lg:px-10">

        <div class="flex flex-col justify-between gap-6 sm:flex-row">

          <div>
            <p class="text-2xl font-semibold">
              arc
            </p>

            <p class="mt-4 max-w-sm text-xs leading-5 text-white/40">
              Arc is a discovery and education platform.
              Information shown does not constitute financial advice
              or an investment recommendation.
            </p>
          </div>

          <div class="text-sm text-white/50">
            © 2026 Arc
          </div>

        </div>

      </div>

    </footer>

  </main>
</Layout>

<style>
  .marquee {
    width: 100%;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 6rem;
    animation: marquee 28s linear infinite;
  }

  .manager {
    flex-shrink: 0;
    white-space: nowrap;

    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;

    opacity: 0.95;
  }

  .manager.serif {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.8rem;
    font-weight: 400;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  /* Pause when user hovers */
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>