---
const { current } = Astro.props;
const steps = [
  { id: "profile", labelShort: "Profile", labelFull: "Your profile" },
  { id: "pathway", labelShort: "Pathway", labelFull: "Your pathway" },
  { id: "matches", labelShort: "Matches", labelFull: "Your matches" },
];
const currentIndex = steps.findIndex((step) => step.id === current);
---

<nav class="journey-progress" aria-label="Your Switchpath journey">
  {steps.map((step, index) => (
    <span
      class="journey-progress-pill"
      data-state={index < currentIndex ? "complete" : index === currentIndex ? "active" : "upcoming"}
      aria-current={index === currentIndex ? "step" : undefined}
    >
      <span class="journey-progress-label-short">{step.labelShort}</span><span class="journey-progress-label-full">{step.labelFull}</span>
    </span>
  ))}
</nav>
