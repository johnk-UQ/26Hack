<header class="border-b border-[var(--line)] bg-[var(--canvas)]">
  <nav class="mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-6 py-5 lg:px-10" aria-label="Main navigation">
    <a href="/" class="focus-ring">
      <img src="/brand/switchpath-mark.png" alt="Switchpath" width="400" height="400" class="block h-8 w-auto -my-0.5 sm:hidden" />
      <img src="/brand/switchpath-lockup.png" alt="Switchpath" width="2172" height="724" class="hidden h-14 w-auto -my-3.5 sm:block" />
    </a>
    <div class="hidden items-center gap-7 text-sm text-[var(--muted)] md:flex">
      <a href="/#how-it-works" class="nav-link focus-ring">How Switchpath helps</a>
      <a href="/#scenarios" class="nav-link focus-ring">Life events</a>
      <a href="/marketplace" class="nav-link focus-ring">Professionals</a>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <button id="restart-demo" type="button" class="whitespace-nowrap text-xs text-[var(--muted)] underline-offset-4 hover:underline sm:text-sm focus-ring">Start over</button>
      <a href="/onboarding" class="button-primary focus-ring whitespace-nowrap">
        <span class="sm:hidden">Get started</span>
        <span class="hidden sm:inline">Tell Switchpath what’s happening</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>
<script>
  const restart = document.querySelector("#restart-demo");
  restart?.addEventListener("click", () => {
    try { window.localStorage.removeItem("switchpath.demoJourney.v1"); window.localStorage.removeItem("switchpath.demoJourney.v2"); } catch { /* storage may be unavailable */ }
    window.location.href = "/onboarding";
  });
</script>
